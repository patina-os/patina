# patina's boot splash: Plymouth's two-step module, which shows pictures and needs no
# script. render_boot_splash (bin/lib.sh) fills this file and draws the pictures next to
# it from branding/logo.txt; `patina install` writes them to the ImageDir below, the
# image build into the live system. The ground is the default theme's background.
[Plymouth Theme]
Name=patina
Description=patina's mark, building itself while the machine boots
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/patina
HorizontalAlignment=.5
VerticalAlignment=.5
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.5
Transition=none
TransitionDuration=0.0
# Debian's initramfs hook copies its logo into every two-step theme as watermark.png,
# over whatever the theme has, and two-step draws it at the right edge. Its place is
# the alignment times the screen's size less its own, so at 2 it lies past the right
# and bottom edges, and Plymouth, which crops every picture to the screen, draws none.
WatermarkHorizontalAlignment=2
WatermarkVerticalAlignment=2
# progress-*.png, the rings, follow the boot's progress up to 22 % of it, then
# animation-*.png, the word and the ▲, play once, and their last picture stays until
# the splash quits. Plymouth paces the progress by the last boot's systemd units and,
# without them (the live image, every first start), at 1/60 a second up to 25 %, then
# at a tenth of that: at nine tenths the rings crawled and the rest jumped in when the
# installer came. At 22 % they arrive in the first 13 seconds on every machine.
ProgressFunction=linear
ShowAnimationPercent=0.22
BackgroundStartColor=${BOOT_GROUND}
BackgroundEndColor=${BOOT_GROUND}
Font=${UI_FONT} 13
TitleFont=${DISPLAY_FONT} 20
MonospaceFont=${MONO_FONT} 11
