# patina21: I/O schedulers by device type, after the configuration CachyOS ships.
# Source: defaults/system/ in the patina21 checkout; `patina install` writes it here.
# Spinning disks: bfq, for interactive fairness.
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
# SATA and MMC solid-state: mq-deadline.
ACTION=="add|change", KERNEL=="sd[a-z]*|mmcblk[0-9]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
# NVMe: none; the device queues for itself.
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/scheduler}="none"
