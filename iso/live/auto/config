#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# live-build options for the patina21 live image. `lb config` runs this file itself when
# it sits in auto/ of the build directory (iso/live/build.sh puts it there).
set -euo pipefail

# amd64 today; arm64 follows in Phase 3 (docs/roadmap.md). The kernel flavour is named
# like the architecture on both.
arch="${PATINA_ARCH:-amd64}"

lb config noauto \
  --distribution trixie \
  --architectures "$arch" \
  --linux-flavours "$arch" \
  --archive-areas "main non-free-firmware" \
  --mirror-bootstrap http://deb.debian.org/debian/ \
  --mirror-binary http://deb.debian.org/debian/ \
  --security true \
  --updates true \
  --binary-images iso-hybrid \
  --bootloaders grub-efi \
  --uefi-secure-boot enable \
  --debian-installer none \
  --memtest none \
  --image-name "patina21-$arch" \
  --iso-volume patina21-installer \
  --iso-application "patina21 installer" \
  --iso-publisher patina21 \
  --bootappend-live "boot=live components quiet hostname=patina21-live username=live noautologin" \
  "$@"
