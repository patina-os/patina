# Calamares branding for the patina installer: the strings, and the names of the files
# iso/live/assets.sh renders next to this one from branding/ and the default theme
# (logo.png, logo-square.svg, wallpaper.png, the slides, stylesheet.qss). assets.sh also
# fills the version from git and the sidebar colours (style) from the palette, so no
# colour is typed here. Nothing rendered is committed.
---
componentName: patina

welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: fullscreen
windowPlacement: center
sidebar: widget
navigation: widget

strings:
  productName: patina
  shortProductName: patina
  version: "0.0.0"
  shortVersion: "0.0.0"
  versionedName: patina
  shortVersionedName: patina
  bootloaderEntryName: Debian GNU/Linux
  productUrl: https://github.com/patina21/patina
  supportUrl: https://github.com/patina21/patina/issues
  knownIssuesUrl: https://github.com/patina21/patina/issues
  releaseNotesUrl: https://github.com/patina21/patina/blob/main/CHANGELOG.md

images:
  productLogo: logo-square.svg      # the square mark: Calamares shows this one at 80x80
  productIcon: logo-square.svg
  productWelcome: logo.png          # the wordmark, rendered with its fonts, on the welcome page
  productWallpaper: wallpaper.png   # the theme's first wallpaper, veiled, behind every page

# Still images instead of a QML slideshow: nothing to execute, nothing to maintain.
# Calamares shows them in turn while it installs.
slideshow:
  - slide-1.png
  - slide-2.png
  - slide-3.png

style: {}   # filled by assets.sh from the palette: SidebarBackground, SidebarText, ...
