# Calamares branding for the patina21 installer: strings, colours and the logo. The logo
# file (logo.svg) is not committed; iso/live/build.sh renders it from branding/logo.txt,
# the only copy, and fills in the version from git. The colours are the default theme's
# palette (themes/amethyst/theme.yaml: base00, base05, base0E), kept by hand because
# Calamares reads this file as it is; the logo's colours build.sh takes from the theme.
---
componentName: patina21

welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: fullscreen
windowPlacement: center
sidebar: widget
navigation: widget

strings:
  productName: patina21
  shortProductName: patina21
  version: "0.0.0"
  shortVersion: "0.0.0"
  versionedName: patina21
  shortVersionedName: patina21
  bootloaderEntryName: Debian GNU/Linux
  productUrl: https://github.com/patina21/patina21
  supportUrl: https://github.com/patina21/patina21/issues
  knownIssuesUrl: https://github.com/patina21/patina21/issues
  releaseNotesUrl: https://github.com/patina21/patina21/blob/main/CHANGELOG.md

images:
  productLogo: logo.svg
  productIcon: logo.svg
  productWelcome: logo.svg

# A still image instead of a QML slideshow: nothing to execute, nothing to maintain.
slideshow:
  - logo.svg

style:
  SidebarBackground: "#15101d"
  SidebarText: "#d9d0e8"
  SidebarTextCurrent: "#15101d"
  SidebarBackgroundCurrent: "#c084fc"
