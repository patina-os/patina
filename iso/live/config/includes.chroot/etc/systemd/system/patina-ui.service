# The installer screen of the live image: an X session on tty7 running Calamares full
# screen. Enabled on the live system by the build hook; removed from the installed
# system by Calamares (modules/shellprocess-firstboot.conf).
[Unit]
Description=patina installer screen (Calamares)
Documentation=https://github.com/patina-os/patina/tree/main/iso
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty7.service
ConditionPathExists=/usr/bin/startx

[Service]
Type=simple
Environment=HOME=/root
WorkingDirectory=/root
# -s 0 -dpms: no screen saver and no blanking, the package step alone outlasts X's 10 minutes
ExecStart=/usr/bin/startx /root/.xinitrc -- vt7 -keeptty -nolisten tcp -s 0 -dpms
Restart=always
RestartSec=5
StandardInput=tty
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=graphical.target
