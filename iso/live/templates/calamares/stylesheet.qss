/* Calamares stylesheet for the patina installer, rendered by iso/live/assets.sh from
   the default theme's palette and the fonts of defaults/settings.yaml; nothing here is
   typed by hand. Written against Qt's Fusion style (root/.xinitrc sets it). The sidebar's
   step list reads its colours from branding.desc's style keys, which assets.sh fills
   from the same palette. Known limit: the partition bars' segment colours are
   Calamares' own and cannot be styled. */

QWidget {
  font-family: "${UI_FONT}";
  font-size: 11pt;
  color: ${BASE05};
  background: transparent;
  selection-background-color: ${ACCENT};
  selection-color: ${BASE00};
}

#mainApp, QMainWindow, QDialog, QMessageBox, QMenu, QWizard {
  background-color: ${BASE00};
}
/* The dialogs' icons in the accent, as the welcome page's are (Qt's own are a blue
   speech bubble and a yellow sign); an error in the palette's red. */
QMessageBox {
  messagebox-question-icon: url(/etc/calamares/branding/patina/help.png);
  messagebox-information-icon: url(/etc/calamares/branding/patina/about.png);
  messagebox-warning-icon: url(/etc/calamares/branding/patina/bugs.png);
  messagebox-critical-icon: url(/etc/calamares/branding/patina/error.png);
}

/* The sidebar and the bar of Back, Next and Cancel are glass over the wallpaper, as
   the desktop's start menu is (start_menu.glass); the wallpaper is blurred under the
   sidebar already (wallpaper.svg). Both are children of #backgroundWidget, the widget
   that holds the wallpaper; the bar has no name of its own, so it is the child that is
   neither the sidebar nor the pages (#viewManager). */
#backgroundWidget > QWidget {
  background-color: rgba(${BASE00_RGB}, ${GLASS});
  border-top: 1px solid rgba(${ACCENT_RGB}, 46);
}
#backgroundWidget > QWidget#viewManager {
  background: transparent;
  border: none;
}
#backgroundWidget > QWidget#sidebarApp {
  background-color: rgba(${BASE00_RGB}, ${GLASS});
  border: none;
  border-right: 1px solid rgba(${ACCENT_RGB}, 46);
}
#view-button-back, #view-button-next, #view-button-cancel {
  margin: 12px 0 6px 0;
}
#view-button-cancel {
  margin-right: 22px;
}
/* Next (Install on the summary page) is the one way forward, so it is the solid button,
   as the default button of a dialog is; Back and Cancel stay outlined. The ID outranks
   the generic rules below, so its hover and disabled looks are spelled out here. */
#view-button-next {
  background-color: ${ACCENT};
  color: ${BASE00};
  font-weight: 600;
}
#view-button-next:hover {
  background-color: ${ACCENT_ALT};
  border-color: ${ACCENT_ALT};
}
#view-button-next:disabled {
  background-color: transparent;
  color: ${BASE03};
  border-color: ${BASE02};
  font-weight: normal;
}

/* The sidebar's steps: Calamares draws each one itself in Qt's application font
   (/etc/fonts/local.conf makes it the layer's) with the colours of branding.desc's
   style keys, and a step's block always fills its row. The room around them is ours:
   the mark sits inset in its 80 px box (logo-square.svg), the list starts below it
   and keeps the steps off the edges. No spacing between the rows: thirteen steps
   with any spacing outgrow the sidebar of a 1280x800 screen and the list scrolls, so
   Finish is cut off on a laptop's 768 lines. */
#sidebarMenuApp {
  background: transparent;
  border: none;
  margin-top: 28px;
  padding: 0 8px;
  qproperty-spacing: 0;
}
#aboutButton {
  color: ${BASE04};
  qproperty-icon: url(/etc/calamares/branding/patina/about.png);
}

/* The welcome page's links, in the accent like the language icon (welcome.conf). */
#supportButton {
  qproperty-icon: url(/etc/calamares/branding/patina/help.png);
}
#knownIssuesButton {
  qproperty-icon: url(/etc/calamares/branding/patina/bugs.png);
}
#releaseNotesButton {
  qproperty-icon: url(/etc/calamares/branding/patina/release.png);
}

/* the glass panels: the groups a page puts its controls in */
QGroupBox, QFrame[frameShape="4"], QFrame[frameShape="6"], #scrollAreaWidgetContents {
  background-color: rgba(${BASE01_RGB}, 200);
  border: 1px solid rgba(${ACCENT_RGB}, 90);
  border-radius: 8px;
}
QGroupBox {
  margin-top: 1.2em;
  padding: 10px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 4px;
  color: ${BASE04};
}
QScrollArea {
  border: none;
}
QLabel {
  background: transparent;
}
#bootInfoLable, #defineInfoLabel {
  color: ${BASE04};
}

/* what the user types into or picks from */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
  background-color: rgba(${BASE02_RGB}, 220);
  border: 1px solid ${BASE03};
  border-radius: 6px;
  padding: 5px 9px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus {
  border-color: ${ACCENT};
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled {
  color: ${BASE03};
  border-color: ${BASE02};
}
QComboBox::drop-down {
  border: none;
  width: 24px;
}
QComboBox QAbstractItemView {
  background-color: ${BASE01};
  border: 1px solid ${ACCENT};
  selection-background-color: ${ACCENT};
  selection-color: ${BASE00};
}

/* buttons: one solid (the default action), the rest outlined */
QPushButton, QToolButton {
  background-color: rgba(${BASE02_RGB}, 200);
  border: 1px solid ${ACCENT};
  border-radius: 6px;
  padding: 6px 16px;
  min-height: 1.4em;
}
QPushButton:hover, QToolButton:hover {
  border-color: ${ACCENT_ALT};
}
QPushButton:pressed, QPushButton:checked, QToolButton:checked {
  background-color: ${BASE02};
  border-color: ${ACCENT_ALT};
}
QPushButton:default {
  background-color: ${ACCENT};
  color: ${BASE00};
  font-weight: 600;
}
QPushButton:default:hover {
  background-color: ${ACCENT_ALT};
}
QPushButton:disabled, QToolButton:disabled {
  color: ${BASE03};
  border-color: ${BASE02};
  background-color: transparent;
}
QPushButton:flat {
  border: none;
  background: transparent;
}

/* lists, trees and tables: the partition page lives here */
QTreeView, QListView, QTableView, QListWidget, QTreeWidget {
  background-color: rgba(${BASE01_RGB}, 200);
  alternate-background-color: rgba(${BASE02_RGB}, 120);
  border: 1px solid ${BASE02};
  border-radius: 6px;
  selection-background-color: ${ACCENT};
  selection-color: ${BASE00};
  outline: none;
}
QTreeView::item, QListView::item, QTableView::item {
  padding: 4px;
}
/* A picked row is tinted with the accent and named in it, as the sidebar's current step
   is; a solid neon bar per list shouted on the keyboard page's two lists. Hovering is
   fainter than picking. */
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
  background-color: rgba(${ACCENT_RGB}, 46);
  color: ${ACCENT};
}
QTreeView::item:hover, QListView::item:hover {
  background-color: rgba(${ACCENT_RGB}, 22);
}
/* after the hover rule, which would otherwise dim the item just clicked, still under
   the pointer */
QTreeView::item:selected:hover, QListView::item:selected:hover,
QTableView::item:selected:hover {
  background-color: rgba(${ACCENT_RGB}, 46);
  color: ${ACCENT};
}
/* The four question pages (packagechooser): roomier rows, and what the picked answer
   brings in a glass card of its own under its picture, in the size of the page's other
   text rather than a footnote. The small name above the picture repeats the picture's
   own title, so it takes no room. */
#products::item {
  padding: 8px 10px;
}
#productName {
  max-height: 0;
  margin: 0;
  padding: 0;
}
#productDescription {
  font-size: 12pt;
  background-color: rgba(${BASE01_RGB}, 200);
  border: 1px solid rgba(${ACCENT_RGB}, 46);
  border-radius: 8px;
  padding: 12px 16px;
}
/* The summary: each step's title in the display face and its lines in a glass card, so
   the last look before the disk is written reads as a list, not text on the wallpaper. */
#summaryItemTitle {
  font-family: "${DISPLAY_FONT}";
  font-size: 13pt;
  color: ${BASE07};
  margin-top: 10px;
}
#summaryItemBody {
  background-color: rgba(${BASE01_RGB}, 200);
  border: 1px solid rgba(${ACCENT_RGB}, 46);
  border-radius: 8px;
}
QHeaderView::section {
  background-color: ${BASE02};
  color: ${BASE04};
  border: none;
  padding: 5px 8px;
}
#partitionBarView {
  background: transparent;
  border: none;
}
/* The legend under the partition bars (the disk page, the summary): Calamares draws
   each partition's name in black and its size in grey whatever the stylesheet says
   (PartitionLabelsView::drawLabel), so the legend gets a light card of its own, the
   palette's lightest colour, on which both can be read. */
PartitionLabelsView {
  background-color: ${BASE07};
  border-radius: 6px;
}

/* the one glowing line: progress. Qt draws the percentage in the middle in one colour,
   over the chunk from half way on: the chunk is translucent, so the lightest text reads
   on it as on the empty bar (a solid neon chunk hid it), and its leading edge glows. */
QProgressBar {
  background-color: ${BASE01};
  border: 1px solid ${ACCENT};
  border-radius: 4px;
  text-align: center;
  font-family: "${MONO_FONT}";
  color: ${BASE07};
  min-height: 1.2em;
}
QProgressBar::chunk {
  background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 rgba(${ACCENT_ALT_RGB}, 102), stop: 1 rgba(${ACCENT_RGB}, 102));
  border-right: 2px solid ${ACCENT};
  border-radius: 3px;
}

/* checks and radios */
QCheckBox, QRadioButton {
  spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
  width: 16px;
  height: 16px;
  background-color: ${BASE02};
  border: 1px solid ${BASE03};
  border-radius: 4px;
}
QRadioButton::indicator {
  border-radius: 8px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border-color: ${ACCENT};
}
/* A ticked box shows its tick and a picked radio its dot, as on every other desktop: a
   plain filled square read as a design, not as an answer. */
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
  background-color: ${ACCENT};
  border-color: ${ACCENT};
}
QCheckBox::indicator:checked {
  image: url(/etc/calamares/branding/patina/check.png);
}
QRadioButton::indicator:checked {
  background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 ${BASE00}, stop: 0.3 ${BASE00}, stop: 0.36 ${ACCENT}, stop: 1 ${ACCENT});
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  border-color: ${BASE02};
}

/* tabs, scrollbars, tooltips, menus */
QTabWidget::pane {
  border: 1px solid ${BASE02};
  border-radius: 6px;
}
QTabBar::tab {
  background: transparent;
  color: ${BASE04};
  padding: 6px 14px;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
  color: ${BASE05};
  border-bottom-color: ${ACCENT};
}
QScrollBar:vertical, QScrollBar:horizontal {
  background: ${BASE01};
  width: 8px;
  height: 8px;
  margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: ${BASE03};
  border-radius: 4px;
  min-height: 24px;
  min-width: 24px;
}
QScrollBar::handle:hover {
  background: ${ACCENT};
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
  background: none;
  border: none;
  height: 0;
  width: 0;
}
QToolTip {
  background-color: ${BASE01};
  color: ${BASE05};
  border: 1px solid ${ACCENT};
  padding: 4px;
}
QMenu::item {
  padding: 6px 20px;
}
QMenu::item:selected {
  background-color: ${ACCENT};
  color: ${BASE00};
}
QSlider::groove:horizontal {
  height: 4px;
  background: ${BASE02};
  border-radius: 2px;
}
QSlider::handle:horizontal {
  width: 14px;
  margin: -6px 0;
  background: ${ACCENT};
  border-radius: 7px;
}
QSlider::sub-page:horizontal {
  background: ${ACCENT};
  border-radius: 2px;
}
