# The local installer screen on the live ISO: an X session on tty7 showing Agama's web
# UI in a kiosk browser. The pattern openSUSE's own Agama live image uses (startx, a
# minimal window manager, Firefox in kiosk mode); our own files, see root/.xinitrc.
[Unit]
Description=patina21 installer screen (Agama web UI in a kiosk browser)
After=agama-web-server.service systemd-user-sessions.service
Wants=agama-web-server.service
Conflicts=getty@tty7.service
ConditionPathExists=/usr/bin/startx

[Service]
Type=simple
Environment=HOME=/root
WorkingDirectory=/root
ExecStart=/usr/bin/startx /root/.xinitrc -- vt7 -keeptty -nolisten tcp
Restart=on-failure
RestartSec=5
StandardInput=tty
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=graphical.target
