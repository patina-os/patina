# First boot of a system installed from the patina image: runs Path A (git clone, then
# `patina install`) on the console before the login screen appears. Installed into
# the image by iso/live/build.sh and enabled in the installed system by Calamares
# (modules/shellprocess-firstboot.conf). Runs once: the script writes
# /var/lib/patina/firstboot-done.
[Unit]
Description=patina first boot: install the layer (Path A)
Documentation=https://github.com/patina-os/patina/tree/main/iso
ConditionPathExists=!/var/lib/patina/firstboot-done
After=network-online.target systemd-user-sessions.service plymouth-start.service
Wants=network-online.target
Before=display-manager.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The boot splash (Plymouth) quits first: it would cover tty1 and the password prompt on
# it. Without Plymouth this does nothing.
ExecStartPre=-/usr/bin/plymouth quit
ExecStart=/usr/local/lib/patina/firstboot.sh
StandardInput=tty
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
