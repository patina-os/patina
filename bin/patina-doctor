#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Check the base, the tools, the theme and what `patina install` put in place; report
# what is missing or differs. Exit 0 when clean, 1 otherwise. Changes nothing.
set -euo pipefail

# shellcheck source=bin/lib.sh
source "$PATINA_PATH/bin/lib.sh"

problems=0

ok() { printf '  ok    %s\n' "$*"; }
bad() {
  printf '  FAIL  %s\n' "$*"
  problems=$((problems + 1))
}
note() { printf '  note  %s\n' "$*"; }

check_base() {
  local name id arch
  # shellcheck source=/dev/null
  name="$(. /etc/os-release && echo "${PRETTY_NAME:-${ID:-unknown}}")"
  # shellcheck source=/dev/null
  id="$(. /etc/os-release && echo "${ID:-}")"
  arch="$(uname -m)"
  echo "base"
  if BACKEND="$(backend_file 2> /dev/null)"; then
    ok "$name, $arch, backend $(basename "$BACKEND" .yaml)"
  else
    bad "$name (ID=$id): no backend in manifest/backends/ serves it"
    BACKEND=""
  fi
  case "$arch" in
    x86_64 | aarch64) ;;
    *) note "$arch is not an architecture the layer is tested on" ;;
  esac
}

check_tools() {
  echo "tools"
  if have_go_yq; then
    ok "yq: $(yq --version)"
  else
    bad "the Go yq is missing (patina install fetches it)"
  fi
  if git -C "$PATINA_PATH" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    ok "checkout: $PATINA_PATH ($(git -C "$PATINA_PATH" describe --tags --always 2> /dev/null))"
  else
    bad "$PATINA_PATH is not a git checkout; patina update needs one"
  fi
  # The link patina install makes, which every hint of patina's ("patina ai login")
  # needs; PATH has ~/.local/bin from the next login, through Debian's ~/.profile.
  if [[ "$(readlink -f "$HOME/.local/bin/patina")" != "$(readlink -f "$PATINA_PATH/bin/patina")" ]]; then
    bad "$HOME/.local/bin/patina does not lead to this checkout, so the patina command is missing (patina install links it)"
  elif [[ "$(readlink -f "$(command -v patina 2> /dev/null || echo /nonexistent)")" == "$(readlink -f "$PATINA_PATH/bin/patina")" ]]; then
    ok "patina on PATH"
  else
    note "$HOME/.local/bin is not on PATH in this shell; it is from the next login"
  fi
}

# opencode's own file: opencode refuses its whole configuration when the file does not
# parse or a file it names is gone (your own API's key, {file:...}), so the agent does
# not start at all, while patina ai still named the provider. Fails when it does not
# parse.
check_agent_file() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" value missing=""
  [[ -f "$file" ]] || return 0
  if ! yq -p json eval '.' "$file" > /dev/null 2>&1; then
    bad "$file does not parse (a mistake, or a comment patina cannot read), and the agent may not start: fix it, or move it away and run patina install"
    return 1
  fi
  while IFS= read -r value; do
    if [[ "$value" =~ \{file:([^}]*)\} && ! -e "${BASH_REMATCH[1]}" ]]; then
      missing+=" ${BASH_REMATCH[1]}"
    fi
  done < <(yq -p json eval '.provider // {} | .. | select(tag == "!!str")' "$file" 2> /dev/null)
  [[ -z "$missing" ]] || bad "the agent does not start, since a file its configuration names is gone:$missing (patina ai login)"
}

# The services `patina ai connect` turned on: opencode refuses its whole configuration
# when a token file one of them names is gone, so the agent would not start at all.
check_services() {
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json" name value names missing=""
  [[ -f "$file" ]] || return 0
  while IFS=$'\t' read -r name value; do
    if [[ "$value" =~ \{file:([^}]*)\} && ! -e "${BASH_REMATCH[1]}" ]]; then
      missing+=" $name"
    fi
  done < <(yq eval -o=tsv '.mcp // {} | to_entries | .[] |
    {"k": .key, "v": (.value | .. | select(tag == "!!str"))} | [.k, .v]' "$file" 2> /dev/null)
  names="$(yq eval -o=yaml '.mcp // {} | keys | join(" ")' "$file" 2> /dev/null)" || return 0
  if [[ -n "$missing" ]]; then
    bad "services whose token file is gone, which stops the agent:$missing (patina ai connect or disconnect each)"
  elif [[ -n "$names" ]]; then
    ok "services: $names"
  fi
}

check_state() {
  echo "state"
  if [[ -e "$PATINA_STATE/installed-at" ]]; then
    ok "installed $(cat "$PATINA_STATE/installed-at"), bundles: $(recorded_bundles | paste -sd ' ')"
    local ai provider agent
    ai="$(cat "$PATINA_STATE/ai" 2> /dev/null || true)"
    provider="$(cat "$PATINA_STATE/ai-provider" 2> /dev/null || true)"
    agent="$(cat "$PATINA_STATE/ai-agent" 2> /dev/null || echo opencode)"
    [[ "$ai" != cloud ]] || ai="cloud, $(provider_name "$provider")"
    [[ -z "$ai" || "$ai" == none ]] || ai="$agent, $ai"
    [[ -z "$ai" ]] || ok "ai agent: $ai"
    if [[ "$ai" == *", cloud, "* ]] && ! ai_logged_in "$agent" "$provider"; then
      note "the agent is not logged in to its provider yet: patina ai login"
    fi
    ! check_agent_file || check_services
  else
    bad "no install recorded in $PATINA_STATE (run patina install)"
  fi
  local pending
  pending="$("$PATINA_PATH/bin/patina-migrate" --list | wc -l)"
  if [[ "$pending" -eq 0 ]]; then
    ok "no pending migration"
  else
    bad "$pending pending migration(s): run patina update, in the desktop's terminal for one that changes the desktop"
  fi
}

check_bundles() {
  local -a bundles packages flatpaks upstream
  local p missing
  mapfile -t bundles < <(recorded_bundles)
  mapfile -t packages < <(bundle_items packages "${bundles[@]}")
  mapfile -t flatpaks < <(bundle_items flatpaks "${bundles[@]}")
  mapfile -t upstream < <(bundle_items upstream "${bundles[@]}")
  for p in $(detected_devices); do
    mapfile -t -O "${#packages[@]}" packages < \
      <(yq eval '.extra_packages[]?' "$PATINA_PATH/devices/$p/device.yaml")
  done
  echo "bundles: ${bundles[*]}"
  missing=""
  for p in "${packages[@]}"; do
    package_installed "$p" || missing="$missing $p"
  done
  if [[ -z "$missing" ]]; then
    ok "packages: all ${#packages[@]} installed"
  else
    bad "packages missing:$missing (run patina install)"
  fi
  missing=""
  for p in "${flatpaks[@]}"; do
    flatpak_installed "$p" || missing="$missing $p"
  done
  if [[ -z "$missing" ]]; then
    ok "flatpaks: all ${#flatpaks[@]} installed"
  else
    bad "flatpaks missing:$missing (run patina install)"
  fi
  missing=""
  for p in "${upstream[@]}"; do
    upstream_installed "$p" || missing="$missing $p"
  done
  if [[ -z "$missing" ]]; then
    ok "upstream tools: all ${#upstream[@]} installed"
  else
    bad "upstream tools missing:$missing (run patina install)"
  fi
}

check_system() {
  local dir src dest differs="" d
  local -a dirs=("$PATINA_PATH/defaults/system") held=() unwanted=()
  echo "system tuning (defaults/system/)"
  for d in $(detected_devices); do
    ok "device: $(yq eval '.name' "$PATINA_PATH/devices/$d/device.yaml") (devices/$d/)"
    [[ ! -d "$PATINA_PATH/devices/$d/system" ]] || dirs+=("$PATINA_PATH/devices/$d/system")
  done
  # A file only bundles this machine lacks name (`system:`) is not expected here.
  mapfile -t held < <(recorded_bundles)
  mapfile -t unwanted < <(system_unwanted "${held[@]}")
  for dir in "${dirs[@]}"; do
    while IFS= read -r src; do
      dest="/etc/${src#"$dir/"}"
      if [[ "$dir" == "$PATINA_PATH/defaults/system" ]] && printf '%s\n' "${unwanted[@]}" | grep -qxF "${src#"$dir/"}"; then
        continue
      fi
      system_in_place "$src" "$dest" || differs="$differs $dest"
    done < <(find "$dir" -type f | sort)
  done
  if [[ -z "$differs" ]]; then
    ok "every file in place and identical"
  else
    bad "missing or different:$differs (run patina install)"
  fi
  if ! booted_with_systemd; then
    note "not booted with systemd (a container?); the tuning cannot be active here"
  fi
}

check_theme() {
  local theme scheme mode line
  echo "theme"
  if ! theme="$(current_theme)"; then
    bad "no theme recorded (run patina theme set <name>)"
    return
  fi
  if ! theme_dir "$theme" > /dev/null; then
    bad "theme '$theme' is recorded but not under themes/"
    return
  fi
  # In place and in use: Plasma's setting and kitty's include line, not only the files.
  if [[ ! -f "${XDG_DATA_HOME:-$HOME/.local/share}/color-schemes/patina-$theme.colors" ]]; then
    bad "$theme: colour scheme missing (run patina theme set $theme)"
  elif command -v kreadconfig6 > /dev/null &&
      scheme="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)" &&
      [[ "$scheme" != "patina-$theme" ]]; then
    bad "$theme: Plasma uses the colour scheme '${scheme:-Breeze}', not patina-$theme (run patina theme set $theme)"
  else
    # The mode in effect: a theme without the mode recorded stays in its own.
    mode="$(current_mode)"
    theme_has_mode "$(theme_dir "$theme")/theme.yaml" "$mode" ||
      mode="$(yq eval '.variant' "$(theme_dir "$theme")/theme.yaml")"
    ok "$theme: colour scheme in place ($mode mode)"
  fi
  if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/kitty/patina.conf" ]]; then
    bad "$theme: terminal colours missing (run patina theme set $theme)"
  elif ! grep -qxF 'include patina.conf' "${XDG_CONFIG_HOME:-$HOME/.config}/kitty/kitty.conf" 2> /dev/null; then
    bad "$theme: kitty.conf does not include the terminal colours (run patina theme set $theme)"
  else
    ok "$theme: terminal colours in place"
  fi
  if [[ -f /usr/local/share/patina/login.png ]]; then
    ok "login screen: wallpaper in place"
  else
    note "login screen: /usr/local/share/patina/login.png not written (run patina theme set $theme where sudo works)"
  fi
  if [[ -d /usr/share/sddm/themes/breeze ]] &&
      ! grep -qsx 'background=/usr/local/share/patina/login.png' /usr/share/sddm/themes/breeze/theme.conf.user; then
    bad "login screen: the Breeze theme does not point at the wallpaper (run patina theme set $theme)"
  fi
  # The user's own keys: a file that is not YAML is left out, and a chord another key
  # has already reaches only one of them (keybindings in lib.sh says which).
  while IFS= read -r line; do
    bad "keys: ${line#patina: }"
  done < <(keybindings 2>&1 > /dev/null)
  if ! command -v kwriteconfig6 > /dev/null; then
    note "kwriteconfig6 is missing: Plasma is not installed here, so only the files were written"
  fi
}

main() {
  case "${1:-}" in
    "") ;;
    -h | --help)
      echo "usage: patina doctor"
      exit 0
      ;;
    *)
      echo "usage: patina doctor" >&2
      exit 1
      ;;
  esac
  check_base
  check_tools
  if ! have_go_yq || [[ -z "$BACKEND" ]]; then
    echo "patina doctor: cannot check further without yq and a backend"
    exit 1
  fi
  check_state
  check_bundles
  check_system
  check_theme
  if [[ $problems -eq 0 ]]; then
    say "doctor: clean"
  else
    say "doctor: $problems problem(s)"
    exit 1
  fi
}

main "$@"
