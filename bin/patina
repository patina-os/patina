#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# patina command-line entry point. Dispatches to bin/patina-<command>; no logic here.
set -euo pipefail

PATINA_PATH="${PATINA_PATH:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
export PATINA_PATH
# shellcheck source=bin/lib.sh
source "$PATINA_PATH/bin/lib.sh"

usage() {
  print_wordmark auto
  echo
  cat <<EOF
usage: patina <command> [args]

commands:
  install   Set up patina on this machine: app bundles, system tuning, app settings
            and the theme (patina install --help for the flags; asks on a terminal)
  update    Pull the latest patina, run pending migrations, then install what the
            bundles gained (unattended, the bundles installed here)
  theme     List, switch, install or remove themes; dark or light (patina theme --help)
  ai        Turn the AI agent on or off after the install (patina ai --help)
  keys      Show the keyboard shortcuts (Meta+K opens the same in a window)
  doctor    Check the base system and report what patina would change
  credits   Name and thank the people and projects patina is made of
  migrate   Run pending migrations without pulling
  version   Print the patina version
  help      Show this help

A command without a bin/patina-<command> file is planned, not implemented yet.
Roadmap: $PATINA_PATH/docs/roadmap.md
EOF
}

version() {
  if git -C "$PATINA_PATH" describe --tags --always --dirty 2>/dev/null; then
    return
  fi
  echo "0.0.0-unknown"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help | -h | --help) usage ;;
    version | -V | --version) version ;;
    install | update | theme | ai | keys | doctor | credits | migrate)
      if [[ -x "$PATINA_PATH/bin/patina-$cmd" ]]; then
        exec "$PATINA_PATH/bin/patina-$cmd" "$@"
      fi
      echo "patina: '$cmd' is planned but not implemented yet (see docs/roadmap.md)." >&2
      exit 2
      ;;
    *)
      echo "patina: unknown command '$cmd' (try 'patina help')." >&2
      exit 1
      ;;
  esac
}

main "$@"
