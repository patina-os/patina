#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# patina21 command-line entry point. Dispatches to bin/patina-<command>; no logic here.
set -euo pipefail

PATINA_PATH="${PATINA_PATH:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
export PATINA_PATH

usage() {
  if [[ -r "$PATINA_PATH/branding/logo.txt" ]]; then
    # logo.txt stays plain 7-bit ASCII (serial console, /etc/issue.d, README);
    # the pink-to-purple gradient is added here, only for an interactive terminal.
    if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" &&
          ( "${COLORTERM:-}" == "truecolor" || "${COLORTERM:-}" == "24bit" ) ]]; then
      local -a lines
      mapfile -t lines < "$PATINA_PATH/branding/logo.txt"
      local n=${#lines[@]} i r g b
      for i in "${!lines[@]}"; do
        if (( n > 1 )); then
          r=$(( 255 + (139 - 255) * i / (n - 1) ))
          g=$(( 95 + (92 - 95) * i / (n - 1) ))
          b=$(( 208 + (246 - 208) * i / (n - 1) ))
        else
          r=255 g=95 b=208
        fi
        printf '\033[38;2;%d;%d;%dm%s\033[0m\n' "$r" "$g" "$b" "${lines[i]}"
      done
    else
      cat "$PATINA_PATH/branding/logo.txt"
    fi
    echo
  fi
  cat <<EOF
usage: patina <command> [args]

commands:
  install   Set up patina21 on this machine: app bundles, system tuning, app settings
            (patina install --help for the flags; theme and TUI come with later phases)
  update    Pull the latest patina21 and run pending migrations
  theme     List, preview or switch themes
  doctor    Check the base system and report what patina21 would change
  migrate   Run pending migrations without pulling
  version   Print the patina21 version
  help      Show this help

A command without a bin/patina-<command> file is planned, not implemented yet.
Roadmap: $PATINA_PATH/docs/roadmap.md
EOF
}

version() {
  if git -C "$PATINA_PATH" describe --tags --always --dirty 2>/dev/null; then
    return
  fi
  echo "0.0.0-unknown"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help | -h | --help) usage ;;
    version | -V | --version) version ;;
    install | update | theme | doctor | migrate)
      if [[ -x "$PATINA_PATH/bin/patina-$cmd" ]]; then
        exec "$PATINA_PATH/bin/patina-$cmd" "$@"
      fi
      echo "patina: '$cmd' is planned but not implemented yet (see docs/roadmap.md)." >&2
      exit 2
      ;;
    *)
      echo "patina: unknown command '$cmd' (try 'patina help')." >&2
      exit 1
      ;;
  esac
}

main "$@"
