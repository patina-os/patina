#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# List, switch, install and remove themes: render a theme through the desktop's renderer
# (desktops/<desktop>/apply.sh) and record it; fetch a community theme from git as data.
set -euo pipefail

# shellcheck source=bin/lib.sh
source "$PATINA_PATH/bin/lib.sh"

usage() {
  cat << EOU
usage: patina theme list | current | set <name> [--layout]
       patina theme install <git-url> | update [<name>] | remove <name>

  list       the themes of patina21 and the installed ones (* marks the current one)
  current    the theme the last 'patina theme set' or 'patina install' applied
  set NAME   render NAME for this user's desktop and make it current. Re-running it
             changes nothing; switching back leaves nothing of the other theme behind
  --layout   also replace this desktop's panels with the theme's layout (the centred
             bar of defaults/settings.yaml); needs a running Plasma session. The first
             'patina install' and a fresh login get the layout anyway; afterwards the
             panels are only touched with this
  install URL  fetch a theme from a git repository (by convention named
             patina21-<name>-theme) into $PATINA_THEMES. Only data is kept:
             theme.yaml, README.md, LICENSE and the wallpapers theme.yaml lists.
             Installing again updates it
  update     fetch every installed theme again from where it came from, or only NAME
  remove NAME  delete an installed theme; not one of patina21's, not the current one
EOU
}

list_themes() {
  local current d name note
  current="$(current_theme || true)"
  for d in "$PATINA_PATH"/themes/[a-z0-9]*/ "$PATINA_THEMES"/[a-z0-9]*/; do
    [[ -f "$d/theme.yaml" ]] || continue
    name="$(basename "$d")"
    note=""
    [[ "$d" == "$PATINA_THEMES"/* ]] && note=" · installed"
    printf '%s %-12s %s (%s)%s\n' "$([[ "$name" == "$current" ]] && echo '*' || echo ' ')" \
      "$name" "$(yq eval '.display_name' "$d/theme.yaml")" "$(yq eval '.variant' "$d/theme.yaml")" "$note"
  done
}

set_theme() {
  local name="$1" dir desktop renderer
  dir="$(theme_dir "$name")" || die "no theme '$name' (try patina theme list)"
  desktop="$(yq eval '.desktop' "$PATINA_PATH/defaults/settings.yaml")"
  renderer="$PATINA_PATH/desktops/$desktop/apply.sh"
  [[ -x "$renderer" ]] || die "no renderer for '$desktop' (desktops/$desktop/apply.sh)"
  PATINA_BUNDLES="$(recorded_bundles | paste -sd ' ')"
  export PATINA_BUNDLES
  say "theme: $name on $desktop"
  "$renderer" "$dir"
  mkdir -p "$PATINA_STATE"
  if [[ "$(cat "$PATINA_STATE/theme" 2> /dev/null)" != "$name" ]]; then
    echo "$name" > "$PATINA_STATE/theme"
  fi
}

# A theme from git, as data only. The clone stays in a temporary directory; what lands
# under $PATINA_THEMES is checked and copied file by file: the names and hints the
# renderer writes into configuration must be plain words, the palette must be colours,
# every wallpaper must be an SVG or PNG under wallpapers/, and nothing may be a link.
# Anything else in the repository (scripts, configs, hidden files) never leaves the clone.
install_theme() {
  local url="$1" tmp src out name key value rel f commit dest
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064 # expand $tmp now: it is local to this function
  trap "rm -rf '$tmp'" EXIT
  src="$tmp/src"
  out="$tmp/out"
  say "theme: fetching $url"
  git clone --quiet --depth 1 -- "$url" "$src" || die "could not clone $url"
  [[ -f "$src/theme.yaml" && ! -L "$src/theme.yaml" ]] || die "$url has no theme.yaml at its top"
  yq eval '.' "$src/theme.yaml" > /dev/null 2>&1 || die "theme.yaml in $url is not YAML"
  name="$(yq eval '.name // ""' "$src/theme.yaml")"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]] ||
    die "the theme's name '$name' is not lowercase kebab-case (letters, digits, -)"
  [[ ! -e "$PATINA_PATH/themes/$name" ]] ||
    die "'$name' is a theme of patina21 itself; the installed one needs another name"
  for key in display_name author; do
    value="$(yq eval ".$key // \"\"" "$src/theme.yaml")"
    [[ "$value" =~ ^[[:alnum:][:space:].,\'()+_-]{1,60}$ && "$value" != *$'\n'* ]] ||
      die "$key '$value' must be 1-60 letters, digits, spaces and . , ' ( ) + _ -"
  done
  for key in license artwork_license plasma.icons plasma.cursors plasma.desktop_theme; do
    value="$(yq eval ".$key // \"x\"" "$src/theme.yaml")"
    [[ "$value" =~ ^[A-Za-z0-9._+-]{1,60}$ ]] || die "$key '$value' must be a plain identifier"
  done
  [[ "$(yq eval '.variant' "$src/theme.yaml")" =~ ^(dark|light)$ ]] || die "variant must be dark or light"
  # The palette: theme_vars dies on a missing or malformed colour; a subshell keeps its
  # tpl[] out of this one.
  ( theme_vars "$src/theme.yaml" "$PATINA_PATH/defaults/settings.yaml" ) ||
    die "the palette of '$name' is incomplete (base00..base0F as #rrggbb)"

  mkdir -p "$out/wallpapers"
  cp "$src/theme.yaml" "$out/theme.yaml"
  for f in README.md LICENSE LICENSE.md LICENSE.txt; do
    if [[ -f "$src/$f" && ! -L "$src/$f" ]]; then
      cp "$src/$f" "$out/$f"
    fi
  done
  while IFS= read -r rel; do
    [[ "$rel" =~ ^wallpapers/[A-Za-z0-9._-]+\.(svg|png)$ && "$rel" != *..* ]] ||
      die "wallpaper '$rel' must be an .svg or .png directly under wallpapers/"
    [[ -f "$src/$rel" && ! -L "$src/$rel" ]] || die "wallpaper '$rel' is not in $url"
    cp "$src/$rel" "$out/$rel"
  done < <(yq eval '.wallpapers[]?' "$src/theme.yaml")

  commit="$(git -C "$src" rev-parse --short HEAD)"
  printf 'url: "%s"\ncommit: "%s"\n' "${url//\"/}" "$commit" > "$out/.source.yaml"
  dest="$PATINA_THEMES/$name"
  mkdir -p "$PATINA_THEMES"
  if [[ -d "$dest" ]] && diff -rq "$out" "$dest" > /dev/null 2>&1; then
    say "theme: $name is up to date ($commit)"
    return
  fi
  rm -rf "$dest"
  mv "$out" "$dest"
  say "theme: installed $name ($commit) into $dest"
  if [[ "$(current_theme || true)" == "$name" ]]; then
    set_theme "$name"
  else
    say "theme: switch to it with 'patina theme set $name'"
  fi
}

update_themes() {
  local d name url found=0
  for d in "$PATINA_THEMES"/[a-z0-9]*/; do
    [[ -f "$d/.source.yaml" ]] || continue
    name="$(basename "$d")"
    [[ -z "${1:-}" || "$1" == "$name" ]] || continue
    found=1
    url="$(yq eval '.url' "$d/.source.yaml")"
    # Each install runs in its own process, so its cleanup trap stays its own.
    "$PATINA_PATH/bin/patina-theme" install "$url"
  done
  if [[ $found -eq 0 ]]; then
    if [[ -n "${1:-}" ]]; then
      die "no installed theme '$1' (patina theme list)"
    fi
    say "theme: no installed themes to update"
  fi
}

remove_theme() {
  local name="$1"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ && -f "$PATINA_THEMES/$name/theme.yaml" ]] ||
    die "no installed theme '$name'; the themes of patina21 itself cannot be removed"
  [[ "$(current_theme || true)" != "$name" ]] ||
    die "'$name' is the current theme; switch to another first (patina theme set <name>)"
  rm -rf "${PATINA_THEMES:?}/$name"
  say "theme: removed $name"
}

main() {
  need_yq
  case "${1:-}" in
    list) list_themes ;;
    current)
      current_theme || { echo "none (patina theme set <name>)"; exit 1; }
      ;;
    set)
      shift
      local name="" arg
      for arg in "$@"; do
        case "$arg" in
          --layout) export PATINA_LAYOUT=1 ;;
          -*) usage >&2; exit 1 ;;
          *) [[ -z "$name" ]] || { usage >&2; exit 1; }; name="$arg" ;;
        esac
      done
      [[ -n "$name" ]] || { usage >&2; exit 1; }
      set_theme "$name"
      ;;
    install)
      [[ $# -eq 2 ]] || { usage >&2; exit 1; }
      install_theme "$2"
      ;;
    update)
      [[ $# -le 2 ]] || { usage >&2; exit 1; }
      update_themes "${2:-}"
      ;;
    remove)
      [[ $# -eq 2 ]] || { usage >&2; exit 1; }
      remove_theme "$2"
      ;;
    -h | --help) usage ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
