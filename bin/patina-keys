#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# The cheat sheet: patina's keys (defaults/keybindings.yaml, the user's own over it) and
# the desktop's own essentials from desktops/<desktop>/actions.yaml, as a table. Meta+K
# shows it in kitty.
set -euo pipefail

# shellcheck source=bin/lib.sh
source "$PATINA_PATH/bin/lib.sh"

wait_key=0
case "${1:-}" in
  "") ;;
  --wait) wait_key=1 ;;   # keep the window open until a key is pressed (Meta+K)
  -h | --help)
    echo "usage: patina keys [--wait]"
    exit 0
    ;;
  *)
    echo "usage: patina keys [--wait]" >&2
    exit 1
    ;;
esac
need_yq

keybindings="$(keybindings)"
desktop="$(yq eval '.desktop' "$PATINA_PATH/defaults/settings.yaml")"
actions="$PATINA_PATH/desktops/$desktop/actions.yaml"

# The chords in the accent of the theme and mode in use on a colour terminal, plain
# otherwise.
on="" off=""
if logo_colour auto; then
  if d="$(theme_dir "$(current_theme || yq eval '.theme' "$PATINA_PATH/defaults/settings.yaml")")"; then
    theme_vars "$d/theme.yaml" "$PATINA_PATH/defaults/settings.yaml" "$(current_mode)"
    printf -v on '\033[1;38;2;%sm' "${tpl[ACCENT_RGB]//,/;}"
    off=$'\033[0m'
  fi
fi

# patina's own launchers come with bundles (Ask kortex and the agent with an AI bundle):
# an action whose launcher is not there has no chord, as the desktop's renderer binds
# none for it, so it is not listed.
declare -A missing=()
if [[ -f "$actions" ]]; then
  while IFS=$'\t' read -r action service; do
    [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/applications/$service" ]] || missing[$action]=1
  done < <(yq eval '.actions | to_entries | .[] | select(.value.service // "" | test("^patina-.*\\.desktop$")) |
    [.key, .value.service] | @tsv' "$actions")
fi

echo
echo "  patina"
# shellcheck disable=SC2016 # $a is a yq variable inside the expression, not a shell one
while IFS=$'\t' read -r action chord name; do
  [[ -z "${missing[$action]:-}" ]] || continue
  # The key's name on the keyboard, Enter, as the lists say; the files keep KDE's Return.
  printf '  %s%-34s%s %s\n' "$on" "${chord//Return/Enter}" "$off" "$name"
done < <(yq eval '.actions as $a | .names | to_entries | .[] | [.key, $a[.key], .value] | @tsv' - <<< "$keybindings")
if [[ -f "$actions" ]] && yq eval -e '.cheatsheet' "$actions" > /dev/null 2>&1; then
  echo
  echo "  ${desktop^}"
  while IFS=$'\t' read -r chord name; do
    printf '  %s%-34s%s %s\n' "$on" "${chord//Return/Enter}" "$off" "$name"
  done < <(yq eval '.cheatsheet[] | [.chord, .name] | @tsv' "$actions")
fi
echo
echo "  To change a key, copy its line, with the actions: line above it, from"
echo "  defaults/keybindings.yaml into ~/.config/patina/keybindings.yaml, change it"
echo "  there, then run: patina theme set $(current_theme || echo '<theme>')"
if [[ $wait_key -eq 1 ]]; then
  read -rsn1 -p "  Press any key to close."
fi
