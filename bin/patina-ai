#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Turn the AI agent on or off after the install: `on` installs the bundle of the answer
# through `patina install --bundles`, `off` takes it out of the record and renders the
# theme again, which drops its launcher, shortcut and command palette entry. `connect`
# turns on a service the agent can work with (defaults/services.yaml).
set -euo pipefail

# shellcheck source=bin/lib.sh
source "$PATINA_PATH/bin/lib.sh"

usage() {
  cat << EOU
usage: patina ai [status] | on [opencode|hermes] [local|cloud] | login | off | connect [<service>] | disconnect <service> | prompt

  status      the agent this machine has (the default)
  on local    the agent with a model Ollama runs on this computer: a few GB of disk,
              best with 16 GB of memory; PATINA_AI_MODEL=<tag> picks the model
  on cloud    the agent with a provider you log in to: on a terminal it asks which, as
              login does; otherwise PATINA_AI_PROVIDER=<id>, or the first of
              ai.cloud.providers in defaults/settings.yaml, and login later
  login       the cloud agent's provider and its key: Mistral and the other European
              ones, your own OpenAI-compatible API (its address and key, then a model
              from its list), Big Pickle (free, no key), Anthropic or OpenAI. The key
              stays in opencode's own login or Hermes' own .env, your own API's in a
              file only you can read. The welcome runs this as its first step
  on opencode ...
              opencode, free (the default): it asks before each change, on the machine
              and in a connected service, and looks around without asking. Expect one
              to a few questions per task
  on hermes ...
              Hermes Agent, free, which remembers across conversations. It changes
              files, stops programs and installs apps without asking, and asks only
              before what it counts as dangerous (deleting a folder, anything as
              root); about 2 GB
  on          asks which on a terminal
  off         no agent: Meta+A, its launcher and \`ai\` in the command palette go away.
              What was installed stays; the end of the output says how to remove it
  connect     the services the agent can work with (Linear, Nextcloud, ...), and which
              are on
  connect <service>
              turn one on: sign in through the browser, or paste a token on the
              terminal (kept readable by you only, never shown to the agent)
  disconnect <service>
              turn one off again and forget its sign-in
  prompt      your own instructions for the agent, in addition to patina's: opens
              ~/.config/patina/agent.md in your editor, and the agent follows them
              from the next request. Empty the file to go back to patina's alone
EOU
}

# The agent this machine has, and the warning about its model (ai_note): a small local
# model errs more often, a US provider takes what is asked out of the EU.
status() {
  local ai agent provider model
  ai="$(cat "$PATINA_STATE/ai" 2> /dev/null || echo none)"
  agent="$(cat "$PATINA_STATE/ai-agent" 2> /dev/null || echo opencode)"
  case "$ai" in
    local)
      model="$(cat "$PATINA_STATE/ai-model" 2> /dev/null || echo '?')"
      say "ai: $agent, local, $model through Ollama"
      ai_note local "$model"
      ;;
    cloud)
      provider="$(cat "$PATINA_STATE/ai-provider" 2> /dev/null || echo '?')"
      if ai_logged_in "$agent" "$provider"; then
        say "ai: $agent, cloud, $provider"
      else
        say "ai: $agent, cloud, $provider, not logged in yet; patina ai login does it"
      fi
      ai_note cloud "$provider"
      ;;
    *) say "ai: none; patina ai on turns it on" ;;
  esac
  [[ "$ai" == none ]] || connected
}

# The services the agent has, on one line of status.
connected() {
  local names=""
  if [[ -f "$opencode_file" ]]; then
    names="$(yq eval -r '.mcp // {} | keys | join(", ")' "$opencode_file" 2> /dev/null || true)"
  fi
  if [[ -z "$names" && -f "$hermes_file" ]]; then
    names="$(yq eval '.mcp_servers // {} | keys | join(", ")' "$hermes_file" 2> /dev/null || true)"
  fi
  say "ai: services: ${names:-none; patina ai connect lists them}"
}

on() {
  local mode="" agent="" word bundle choice ai now ask_agent=0 ask_mode=0 step=agent
  local -a lines
  for word in "$@"; do
    case "$word" in
      local | cloud) mode="$word" ;;
      opencode | hermes) agent="$word" ;;
      *) die "patina ai on takes opencode or hermes, and local or cloud, not '$word'" ;;
    esac
  done
  ai="$(cat "$PATINA_STATE/ai" 2> /dev/null || echo none)"
  # Neither given, on a terminal: which agent first; otherwise that one (opencode before
  # any). The one this machine has is marked.
  if [[ $# -eq 0 && -t 0 && -t 1 ]] && command -v gum > /dev/null; then
    ask_agent=1
  fi
  if [[ -z "$mode" ]]; then
    if [[ ! -t 0 || ! -t 1 ]] || ! command -v gum > /dev/null; then
      die "on needs local or cloud (patina ai --help)"
    fi
    ask_mode=1
  fi
  # The questions, each one back with Ctrl+C or its Back line, the first back to where
  # patina ai was started: the agent, where its model runs, and for a cloud agent on a
  # terminal the provider and what patina keeps of its login. Then the install and the
  # agent's own login; elsewhere the install alone, and login later.
  while true; do
    case "$step" in
      agent)
        if [[ $ask_agent -eq 1 ]]; then
          now=""
          [[ "$ai" == none ]] || now="$(current_agent)"
          mapfile -t lines < <(agent_lines)
          mapfile -t lines < <(mark_now "$now" "${lines[@]}")
          choice="$(pick "AI agent (Meta+A, and ai in the command palette)" "${lines[@]}")" || exit 0
          agent="${choice%% *}"
        fi
        [[ -n "$agent" ]] || agent="$(current_agent)"
        step=mode
        ;;
      mode)
        if [[ $ask_mode -eq 1 ]]; then
          now=""
          [[ "$ai" == none || "$agent" != "$(current_agent)" ]] || now="$ai"
          mapfile -t lines < <(mark_now "$now" "local  on this computer, nothing leaves it" \
            "cloud  a provider you log in to")
          if ! choice="$(pick "Where $agent's model runs" "${lines[@]}")"; then
            [[ $ask_agent -eq 1 ]] || exit 0
            step=agent
            continue
          fi
          mode="${choice%% *}"
        fi
        step=provider
        ;;
      provider)
        provider=""   # none from a provider list left with Back
        if [[ "$mode" == cloud && -t 0 && -t 1 ]] && command -v gum > /dev/null && ! provider_step "$agent"; then
          [[ $ask_mode -eq 1 ]] || exit 0
          step=mode
          continue
        fi
        break
        ;;
    esac
  done
  bundle="$(ai_bundle "$mode" "$agent")" || die "no bundle in manifest/bundles/ answers ai: $mode with $agent"
  PATINA_AI="$mode" PATINA_AI_AGENT="$agent" PATINA_AI_PROVIDER="${provider:-${PATINA_AI_PROVIDER:-}}" \
    "$PATINA_PATH/bin/patina-install" --bundles "$bundle"
  [[ -z "$provider" ]] || after_install "$agent"
}

settings="$PATINA_PATH/defaults/settings.yaml"
ai_keys="${XDG_CONFIG_HOME:-$HOME/.config}/patina/ai"
provider=""

# The cloud provider, on a terminal with gum, and what patina keeps of its login, asked
# before the install writes the agent's configuration: your own API's address, key and
# model, or Hermes' key. opencode's own login comes after the install (after_install).
# Sets provider; fails when it is left with Ctrl+C or Back, and a step after the list
# goes back to it. provider_step <agent>
provider_step() {
  local choice keeps="opencode's own login" key value now="" rc
  local -a lines
  [[ "$1" != hermes ]] || keeps="Hermes' own .env"
  mapfile -t lines < <(yq eval "$(offered_providers "$1") | (.id + \"|\" + .name)" "$settings" |
    awk -F'|' '{ printf "%-10s %s\n", $1, $2 }')
  if [[ "$(cat "$PATINA_STATE/ai" 2> /dev/null || true)" == cloud && "$1" == "$(current_agent)" ]]; then
    now="$(cloud_provider "$1")"
  fi
  mapfile -t lines < <(mark_now "$now" "${lines[@]}")
  while true; do
    choice="$(pick "Cloud provider for $1 (the key stays in $keeps)" "${lines[@]}")" || return 1
    provider="${choice%% *}"
    case "$(provider_login "$provider")" in
      endpoint) endpoint_step "$1" || continue ;;
      key)
        [[ "$1" == hermes ]] || return 0
        key="$(P="$provider" yq eval '.ai.cloud.providers[] | select(.id == strenv(P)) | .hermes.key' "$settings")"
        if ai_logged_in hermes "$provider"; then
          # Keep is the key Hermes has; Ctrl+C (gum's 130) goes back to the list.
          rc=0
          gum confirm "Hermes has a key for $provider. Replace it? (Ctrl+C: Back)" \
            --affirmative Replace --negative Keep --default=false || rc=$?
          [[ $rc -ne 130 ]] || continue
          [[ $rc -eq 0 ]] || return 0
        fi
        value="$(gum input --password --header "Your $provider API key (kept in Hermes' own .env, readable by you only) · Ctrl+C: Back" \
          --placeholder "paste it here")" || continue
        [[ -n "$value" ]] || die "no key entered, nothing changed"
        mkdir -p "$hermes_home"
        hermes_env "$key" "$value"
        ;;
    esac
    return 0
  done
}

# Your own OpenAI-compatible API: its address, its key and a model from the list it
# gives (GET /models, at the address or under its /v1), typed in when it gives none.
# The list holds its chat models where it says which (a `modality`, as some servers
# give), and each line is a model's name whole: a name may hold spaces ("Qwen 3.8 27B").
# The key goes to a file only the user can read, which opencode's entry names, or to
# Hermes' own .env; a server without keys gets "none", which it ignores. The address and
# the model go to the state directory, where patina install finds them. Each question
# goes one back with Ctrl+C; the first fails, back to the providers. endpoint_step <agent>
endpoint_step() {
  local url="" key models="" model="" try step=url now line body code codes
  local -a lines
  while true; do
    case "$step" in
      url)
        url="$(gum input --header "The address of your OpenAI-compatible API · Ctrl+C: Back" \
          --placeholder "https://ai.example.com/v1" \
          --value "${url:-$(yq eval '.url // ""' "$PATINA_STATE/ai-endpoint.yaml" 2> /dev/null || true)}")" || return 1
        url="${url%/}"
        if [[ ! "$url" =~ ^https?://[^/]+ ]]; then
          warn "an address starts with https:// or http://, not '$url'"
          continue
        fi
        step=key
        ;;
      key)
        if ! key="$(gum input --password --header "Its API key (empty for a server without one) · Ctrl+C: Back" \
            --placeholder "paste it here")"; then
          step=url
          continue
        fi
        [[ -n "$key" ]] || key=none
        models=""
        codes=""
        body="$(mktemp)"
        for try in "$url" "$url/v1"; do
          [[ "$try" != "$url/v1" || "$url" != */v1 ]] || continue
          # The key on curl's standard input, not its command line, which other users can
          # see. The status tells a refused key (401, 403) and no answer at all (000)
          # from a server that answers without a list.
          code="$(curl -sS -m 15 -o "$body" -w '%{http_code}' -H @- "$try/models" \
            <<< "Authorization: Bearer $key" 2> /dev/null)" || true
          codes+=" ${code:-000}"
          [[ "$code" == 2* ]] || continue
          models="$(yq eval -p json '.data[] | select((.modality // "chat") == "chat") | .id' \
            "$body" 2> /dev/null)" || models=""
          if [[ -n "$models" ]]; then
            url="$try"
            break
          fi
        done
        rm -f "$body"
        if [[ -z "$models" && "$codes" =~ (401|403) ]]; then
          warn "ai: $url refused this key (HTTP ${BASH_REMATCH[1]}); enter it again"
          continue
        fi
        if [[ -z "$models" && "$codes" =~ ^( 000)+$ ]]; then
          warn "ai: no API answers at $url; check the address"
          step=url
          continue
        fi
        step=model
        ;;
      model)
        if [[ -n "$models" ]]; then
          now="$(yq eval '.model // ""' "$PATINA_STATE/ai-endpoint.yaml" 2> /dev/null || true)"
          # Not mark_now, which takes a line's first word for the model's name.
          lines=()
          while IFS= read -r line; do
            [[ "$line" != "$now" ]] || line+=" (now)"
            lines+=("$line")
          done <<< "$models"
          if model="$(pick "Model ($(wc -l <<< "$models") at $url)" "${lines[@]}")"; then
            model="${model% (now)}"
            break
          fi
        else
          say "ai: $url gave no list of models; type the model's name"
          model="$(gum input --header "The model's name · Ctrl+C: Back" --placeholder "as the API names it")" && break
        fi
        step=key
        ;;
    esac
  done
  [[ -n "$model" ]] || die "no model picked, nothing changed"
  if [[ "$1" == hermes ]]; then
    mkdir -p "$hermes_home"
    hermes_env PATINA_CUSTOM_API_KEY "$key"
  else
    (umask 077 && mkdir -p "$ai_keys" && printf '%s\n' "$key" > "$ai_keys/custom.key")
    chmod 600 "$ai_keys/custom.key"
  fi
  mkdir -p "$PATINA_STATE"
  URL="$url" MODEL="$model" yq eval -n '.url = strenv(URL) | .model = strenv(MODEL)' > "$PATINA_STATE/ai-endpoint.yaml"
  say "ai: your own API at $url, $model"
}

# After the install: opencode's own login to the provider (it keeps the key, patina
# never sees it), and kortex stopped, so the next `ai` starts the agent with the new
# provider: its server read the configuration when it started. after_install <agent>
after_install() {
  if [[ "$1" == opencode && "$(provider_login "$provider")" == key ]]; then
    if ! ai_logged_in opencode "$provider" ||
        gum confirm "opencode is logged in to $provider. Log in again?" --affirmative "Log in" --negative Keep --default=false; then
      say "ai: log in to $provider; opencode keeps the key, patina never sees it"
      opencode auth login --provider "$provider" || say "ai: not logged in; patina ai login tries again"
    fi
  fi
  if pkill -TERM -u "$(id -u)" -f kortex/kortex.py; then
    say "kortex: the next ai starts $1 with $provider"
  fi
  status
}

# The cloud agent's provider and its key, on a terminal: the questions, the install
# that writes the agent's configuration, the agent's own login.
login() {
  local ai agent
  [[ -t 0 && -t 1 ]] || die "patina ai login asks on a terminal; the welcome (patina welcome --window) has it as a step"
  command -v gum > /dev/null || die "patina ai login asks with gum (the base bundle): run patina install first"
  ai="$(cat "$PATINA_STATE/ai" 2> /dev/null || echo none)"
  case "$ai" in
    cloud) ;;
    local) die "the agent's model runs on this computer; patina ai on cloud moves it to a provider and logs in" ;;
    *) die "no AI agent yet; patina ai on cloud turns one on and logs in" ;;
  esac
  agent="$(current_agent)"
  provider_step "$agent" || exit 0
  PATINA_AI=cloud PATINA_AI_AGENT="$agent" PATINA_AI_PROVIDER="$provider" \
    "$PATINA_PATH/bin/patina-install" --bundles "$(ai_bundle cloud "$agent")"
  after_install "$agent"
}

off() {
  local b theme
  [[ "$(cat "$PATINA_STATE/ai" 2> /dev/null || echo none)" != none ]] || { status; return; }
  echo none > "$PATINA_STATE/ai"
  # The record keeps every bundle installed so far; the AI ones leave it, so the
  # renderer drops what belongs to the agent and doctor stops checking it.
  for b in $(all_bundles); do
    if yq eval -e '.ai' "$PATINA_PATH/manifest/bundles/$b.yaml" > /dev/null 2>&1; then
      sed -i "/^$b\$/d" "$PATINA_STATE/bundles"
    fi
  done
  say "ai: none"
  if theme="$(current_theme)"; then
    "$PATINA_PATH/bin/patina-theme" set "$theme"
  fi
  say "ai: the agent, kortex and Ollama stay installed; patina ai on brings it back"
  if command -v ollama > /dev/null; then
    say "ai: Ollama and its models take the most space; the README's AI section says how to remove them"
  fi
}

services="$PATINA_PATH/defaults/services.yaml"
opencode_file="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
hermes_home="${HERMES_HOME:-$HOME/.hermes}"
hermes_file="$hermes_home/config.yaml"
tokens="${XDG_CONFIG_HOME:-$HOME/.config}/patina/services"

# Write an agent's file through yq when the result differs: write_config <file> <json|yaml>
# <yq expression>, with the expression's strenv() values in the environment. Fails when
# nothing changed.
write_config() {
  local tmp
  tmp="$(mktemp)"
  if ! yq eval -o="$2" -I=2 "$3" "$1" > "$tmp" 2> /dev/null; then
    rm -f "$tmp"
    die "cannot parse $1 (comments?); change it by hand"
  fi
  if cmp -s "$tmp" "$1"; then
    rm -f "$tmp"
    return 1
  fi
  cp "$tmp" "$1"
  rm -f "$tmp"
}

# Fill a placeholder in every string of an entry: fill <entry, JSON> <placeholder> <value>.
fill() {
  K="$2" V="$3" yq eval -o=json -I=0 '(.. | select(tag == "!!str")) |= (split(strenv(K)) | join(strenv(V)))' <<< "$1"
}

# Set or drop a line of Hermes' own .env, readable by the user only: hermes_env <name> [<value>].
hermes_env() {
  local env="$hermes_home/.env"
  [[ -f "$env" || $# -gt 1 ]] || return 0
  (umask 077 && { grep -v "^$1=" "$env" 2> /dev/null || true; [[ $# -lt 2 ]] || printf '%s=%s\n' "$1" "$2"; } > "$env.new")
  mv "$env.new" "$env"
  chmod 600 "$env"
}

services_list() {
  local name state
  for name in $(yq eval 'keys | .[]' "$services"); do
    state=off
    if { [[ -f "$opencode_file" ]] && NAME="$name" yq eval -e '.mcp[strenv(NAME)]' "$opencode_file" > /dev/null 2>&1; } ||
      { [[ -f "$hermes_file" ]] && NAME="$name" yq eval -e '.mcp_servers[strenv(NAME)]' "$hermes_file" > /dev/null 2>&1; }; then
      state=on
    fi
    printf '  %-10s %-4s %s\n' "$name" "$state" "$(yq eval ".\"$name\".description" "$services")"
  done
  # What the agent has beside patina's presets: a server added by hand, or by the agent.
  if [[ -f "$opencode_file" ]]; then
    for name in $(yq eval -r '.mcp // {} | keys | .[]' "$opencode_file" 2> /dev/null); do
      yq eval -e ".\"$name\"" "$services" > /dev/null 2>&1 ||
        printf '  %-10s %-4s %s\n' "$name" on "your own · in $opencode_file"
    done
  fi
  say "ai: patina ai connect <service> turns one on, on a terminal: it signs in or asks for a token there"
}

connect() {
  local name="${1:-}" sign_in entry key prompt value token="" i why
  local -a fills=()
  if [[ -z "$name" ]]; then
    services_list
    return
  fi
  name="${name,,}"   # GitHub, as its name is written
  yq eval -e ".\"$name\"" "$services" > /dev/null 2>&1 || die "no service '$name'; patina ai connect lists them"
  [[ -f "$opencode_file" || -f "$hermes_file" ]] || die "no AI agent on this machine yet; patina ai on first"
  sign_in="$(yq eval ".\"$name\".sign_in" "$services")"
  # What the terminal asks: the preset's values, then a token. Only a person types them,
  # so the agent, which has no terminal, hands this step to the user.
  if yq eval -e ".\"$name\" | (has(\"ask\") or .sign_in == \"token\")" "$services" > /dev/null 2>&1; then
    [[ -t 0 && -t 1 ]] ||
      die "$name needs you at a terminal: run 'patina ai connect $name' there. It asks for $(yq eval ".\"$name\".token" "$services"); the agent never sees it"
  fi
  # A sign-in in the browser waits for the user as long as it takes; the agent's
  # commands end after two minutes, and it then tried again behind the user's back.
  [[ "$sign_in" != browser || ( -t 0 && -t 1 ) ]] ||
    die "$name signs in through your browser: run 'patina ai connect $name' on a terminal and finish the sign-in there"
  while IFS=$'\t' read -r key prompt; do
    [[ -n "$key" ]] || continue   # yq prints an empty line for a preset without questions
    read -rp "$prompt: " value < /dev/tty
    [[ -n "$value" ]] || die "$name: nothing entered, nothing changed"
    [[ "$key" != HOST || "$value" =~ ^https?://[^[:space:]/]+ ]] ||
      die "$name: an address starts with https://, nothing changed"
    fills+=("\${$key}" "$value")
  done < <(yq eval ".\"$name\".ask // [] | .[] | [.key, .prompt] | @tsv" "$services")
  if [[ "$sign_in" == token ]]; then
    read -rsp "Paste $(yq eval ".\"$name\".token" "$services"): " token < /dev/tty
    echo
    [[ -n "$token" ]] || die "$name: no token entered, nothing changed"
  fi
  if [[ -f "$opencode_file" ]]; then
    entry="$(yq eval -o=json -I=0 ".\"$name\".opencode" "$services")"
    if [[ -n "$token" ]]; then
      # Private from the start: in a directory others could write, a token file could
      # be theirs before patina writes the token into it.
      (umask 077 && mkdir -p "$tokens" && printf '%s\n' "$token" > "$tokens/$name.token")
      chmod 600 "$tokens/$name.token"
      entry="$(fill "$entry" "\${TOKEN_FILE}" "$tokens/$name.token")"
    fi
    for ((i = 0; i < ${#fills[@]}; i += 2)); do entry="$(fill "$entry" "${fills[i]}" "${fills[i + 1]}")"; done
    NAME="$name" ENTRY="$entry" write_config "$opencode_file" json '.mcp[strenv(NAME)] = (strenv(ENTRY) | from_json)' || true
    service_rules "$name"
    if [[ "$sign_in" == browser ]]; then
      say "ai: sign in to $name in the browser; opencode keeps the sign-in, patina never sees it"
      if opencode mcp auth "$name"; then
        say "ai: $name is on for opencode"
      else
        say "ai: $name is set up for opencode but not signed in; later: opencode mcp auth $name"
      fi
      # A running agent took the service before the sign-in and would keep it unsigned.
      pkill -TERM -u "$(id -u)" -f kortex/kortex.py || true
    elif why="$(refused "$name")"; then
      warn "ai: $name is set up for opencode, but it did not answer ($why); check what you entered and run 'patina ai connect $name' again"
    else
      say "ai: $name is on for opencode; kortex hands it to a running agent at once"
    fi
    say "ai: its tools that change something ask first, in the command palette and the terminal"
  fi
  if [[ -f "$hermes_file" ]]; then
    entry="$(yq eval -o=json -I=0 ".\"$name\".hermes" "$services")"
    [[ -z "$token" ]] || hermes_env "PATINA_${name^^}_TOKEN" "$token"
    for ((i = 0; i < ${#fills[@]}; i += 2)); do entry="$(fill "$entry" "${fills[i]}" "${fills[i + 1]}")"; done
    NAME="$name" ENTRY="$entry" write_config "$hermes_file" yaml '.mcp_servers[strenv(NAME)] = (strenv(ENTRY) | from_json)' || true
    say "ai: $name is on for Hermes, from its next conversation (kortex starts its gateway again)"
    say "ai: its tools that change something ask first, in the command palette"
    if [[ "$sign_in" == browser ]]; then
      say "ai: sign in to $name in the browser; Hermes keeps the sign-in, patina never sees it"
      hermes mcp login "$name" || say "ai: not signed in; later: hermes mcp login $name"
    fi
  fi
}

# The rules that make a service's tools ask (service_permissions): service_rules <name>.
service_rules() {
  local tmp
  tmp="$(mktemp)"
  if service_permissions "$opencode_file" "$1" > "$tmp" 2> /dev/null && ! cmp -s "$tmp" "$opencode_file"; then
    cp "$tmp" "$opencode_file"
  fi
  rm -f "$tmp"
}

# Whether a service just connected did not answer: opencode's own list says which do
# not, with the reason on the line after (a token the service refuses, an address that
# is no Nextcloud). Prints the reason and succeeds when it did not: refused <name>.
refused() {
  local out
  out="$(opencode mcp list 2> /dev/null | sed 's/\x1b\[[0-9;]*m//g')" || return 1
  grep -q " $1 failed" <<< "$out" || return 1
  grep -A1 -m1 " $1 failed" <<< "$out" | tail -n 1 | sed 's/^[^[:alnum:]]*//'
}

disconnect() {
  local name="${1:-}" off=0
  [[ -n "$name" ]] || die "disconnect needs a service; patina ai connect lists them"
  name="${name,,}"
  [[ -f "$opencode_file" || -f "$hermes_file" ]] || die "no AI agent on this machine"
  if [[ -f "$opencode_file" ]] && NAME="$name" write_config "$opencode_file" json '
      del(.mcp[strenv(NAME)]) |
      with(select(has("permission")); .permission |= with_entries(select(.key | test("^" + strenv(NAME) + "_") | not)))'; then
    off=1
    if [[ "$(yq eval ".\"$name\".sign_in // \"\"" "$services")" == browser ]] && command -v opencode > /dev/null; then
      opencode mcp logout "$name" > /dev/null 2>&1 || true
    fi
  fi
  if [[ -f "$hermes_file" ]] && NAME="$name" yq eval -e '.mcp_servers[strenv(NAME)]' "$hermes_file" > /dev/null 2>&1; then
    off=1
    # Hermes' own command also forgets the sign-in; it asks, and takes yes without a terminal.
    if command -v hermes > /dev/null; then
      hermes mcp remove "$name" < /dev/null > /dev/null 2>&1 || true
    fi
    NAME="$name" write_config "$hermes_file" yaml 'del(.mcp_servers[strenv(NAME)])' || true
  fi
  rm -f "$tokens/$name.token"
  hermes_env "PATINA_${name^^}_TOKEN"
  if [[ $off -eq 1 ]]; then
    # A running agent would keep the service, and its token, until it next starts.
    pkill -TERM -u "$(id -u)" -f kortex/kortex.py || true
    say "ai: $name is off"
  else
    say "ai: $name was not on"
  fi
}

# Hermes' question before a service's tool: its `pre_tool_call` hook (written into
# ~/.hermes/config.yaml by the install) runs this for every tool of an MCP server, with
# the call as JSON on stdin. Hermes asks only before a command it counts as dangerous,
# and no tool of a service is one: a ticket closed, a note deleted for good ran without
# a word. A tool the service's preset names as reading only (`reads`) passes; any other
# is sent to Hermes' approval, which kortex shows as a row to allow. Hermes loads a
# service's tools lazily and calls them through its own `tool_call`, which names the
# tool in its input.
gate() {
  local payload name server tool pattern given=.tool_input
  payload="$(cat)"
  name="$(yq -p=json eval -r '.tool_name // ""' <<< "$payload")"
  if [[ "$name" == tool_call ]]; then
    name="$(yq -p=json eval -r '.tool_input.name // ""' <<< "$payload")"
    given=.tool_input.arguments
  fi
  [[ "$name" == mcp__*__* ]] || return 0
  server="${name#mcp__}"
  tool="${server#*__}"
  server="${server%%__*}"
  while read -r pattern; do
    # shellcheck disable=SC2053 # the right side is the preset's pattern
    [[ -z "$pattern" || "$tool" != $pattern ]] || return 0
  done < <(N="$server" yq eval -r '.[strenv(N)].reads // [] | .[]' "$services")
  M="$server: $tool $(yq -p=json eval -o=json -I=0 "$given // {}" <<< "$payload")" K="patina:$server:$tool" \
    yq eval -n -o=json -I=0 '{"action": "approve", "message": strenv(M), "rule_key": strenv(K)}'
}

# Your own instructions for the agent, in addition to patina's (own_rules_file): on a
# terminal the file opens in the editor first, a short note in it the first time; then
# the agent this machine has gets them (opencode the file's name, Hermes its text), and
# kortex stops, so the next request starts the agent with them. kortex's "Edit the
# agent's instructions" runs this in a terminal.
prompt() {
  local own before changed=0
  own="$(own_rules_file)"
  if [[ ! -f "$own" ]]; then
    mkdir -p "$(dirname "$own")"
    cat > "$own" << 'EOT'
<!-- Your own instructions for the AI agent, in addition to patina's. Write them as you
would tell a person: the language it answers in, how short, what it leaves alone. -->
EOT
  fi
  before="$(cksum < "$own")"
  if [[ -t 0 && -t 1 ]]; then
    if command -v sensible-editor > /dev/null; then
      sensible-editor "$own"
    else
      "${VISUAL:-${EDITOR:-nano}}" "$own"
    fi
  fi
  [[ "$(cksum < "$own")" == "$before" ]] || changed=1
  if [[ "$(current_ai)" == none ]]; then
    say "ai: your instructions are in $own; the agent gets them once patina ai on turns it on"
    return 0
  fi
  if [[ "$(current_agent)" == hermes ]]; then
    if [[ -f "$hermes_file" ]] && RULES="$(hermes_rules)" \
        write_config "$hermes_file" yaml '.agent.environment_hint = strenv(RULES)'; then
      changed=1
    fi
  elif [[ -f "$opencode_file" ]]; then
    if RULES="$PATINA_PATH/defaults/agent.md" OWN_FILE="$own" OWN="$own" \
        write_config "$opencode_file" json "$opencode_rules"; then
      changed=1
    fi
  fi
  if [[ "$changed" == 1 ]]; then
    pkill -TERM -u "$(id -u)" -f kortex/kortex.py || true
    say "ai: the agent follows your instructions ($own) from the next request"
  else
    say "ai: your instructions ($own) are unchanged"
  fi
}

main() {
  case "${1:-status}" in
    status) status ;;
    gate) gate ;;
    on)
      shift
      on "$@"
      ;;
    login) login ;;
    off) off ;;
    connect) connect "${2:-}" ;;
    disconnect) disconnect "${2:-}" ;;
    prompt) prompt ;;
    -h | --help) usage ;;
    *)
      usage >&2
      die "unknown argument '$1'"
      ;;
  esac
}

main "$@"
