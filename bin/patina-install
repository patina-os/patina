#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Install the layer: the chosen bundles (packages through this base's backend, flatpaks
# from Flathub, the upstream recipes), the system tuning, the app settings, the AI agent
# and the theme, all from the data files. Idempotent: a second run changes nothing and
# says so.
set -euo pipefail

# shellcheck source=bin/lib.sh
source "$PATINA_PATH/bin/lib.sh"

usage() {
  cat << EOU
usage: patina install [--bundles <a,b,...>] [--all] [--list] [--unattended]

  --bundles a,b  install these bundles; base is always included, and nothing already
                 installed is removed. Default: the bundles marked default
  --all          every bundle, the opt-in ones (agents) included
  --list         show the bundles and exit
  --unattended   no questions, defaults for everything (same as PATINA_UNATTENDED=1):
                 the contract the image's first boot and CI use

On a terminal, without --bundles or --all, the install asks (with gum): the theme, the
app bundles, the AI agent, then a summary and a yes. The theme: PATINA_THEME=<name>
picks one (patina theme list) and skips that question; otherwise the theme already set
on this machine, or the default of defaults/settings.yaml, is offered first.

The AI agent (opencode): PATINA_AI=local|cloud|none answers that question, and
PATINA_AI_MODEL=<tag> the local model and PATINA_AI_PROVIDER=<id> the cloud provider
(ai.local and ai.cloud in defaults/settings.yaml);
otherwise the answer of the last install, or ai.mode, is offered first and taken when
unattended. --bundles adds an agent only when it names ai-local or ai-cloud.
EOU
}

changes=0
failed=0
tui=0
first_install=0

changed() {
  changes=$((changes + 1))
}

# A section line before each part of the install, only when the questions were asked;
# unattended output stays as it is.
section() {
  [[ $tui -eq 1 ]] || return 0
  echo
  gum style --bold --foreground "${tpl[ACCENT]}" "── $1 ──"
}

# The questions, on a terminal: the theme, the app bundles, the AI agent, a summary and
# a yes. Sets PATINA_THEME, bundles, ai, PATINA_AI_MODEL and PATINA_AI_PROVIDER. Esc or Cancel leaves
# without a change. Bundle descriptions carry no comma: gum takes the preselected lines
# as a comma-separated list.
ask() {
  local current d mode name kind lines choice chosen_lines b
  local -a theme_lines=() bundle_lines=() preselected=() ai_lines=() provider_lines=() model_lines=()
  current="${PATINA_THEME:-$(current_theme || yq eval '.theme' "$PATINA_PATH/defaults/settings.yaml")}"
  d="$(theme_dir "$current")" || die "no theme '$current' under themes/ (try patina theme list)"
  mode="$(current_mode)"
  theme_vars "$d/theme.yaml" "$PATINA_PATH/defaults/settings.yaml" "$mode"
  tui_colors
  print_wordmark auto
  echo
  gum style --foreground "${tpl[BASE04]}" \
    "patina $("$PATINA_PATH/bin/patina" version) · $(basename "$BACKEND" .yaml) · $(uname -m)"
  echo
  if [[ -z "${PATINA_THEME:-}" ]]; then
    mapfile -t theme_lines < <("$PATINA_PATH/bin/patina-theme" list | sed 's/^[* ] //')
    choice="$(printf '%s\n' "${theme_lines[@]}" | grep "^$current ")" || choice="${theme_lines[0]}"
    choice="$(gum choose --header "Theme" --selected "$choice" "${theme_lines[@]}")" || exit 0
    PATINA_THEME="${choice%% *}"
    export PATINA_THEME
    echo
  fi
  for name in $(all_bundles); do
    yq eval -e '.required == true or .ai' "$PATINA_PATH/manifest/bundles/$name.yaml" > /dev/null 2>&1 && continue
    kind="opt-in"
    yq eval -e '.default == true' "$PATINA_PATH/manifest/bundles/$name.yaml" > /dev/null 2>&1 && kind="default"
    lines="$(printf '%-9s %-8s %s' "$name" "($kind)" "$(yq eval '.description' "$PATINA_PATH/manifest/bundles/$name.yaml")")"
    bundle_lines+=("$lines")
    [[ "$kind" == default ]] && preselected+=("$lines")
  done
  chosen_lines="$(gum choose --no-limit --header "App bundles (x or space toggles, enter confirms)" \
    --selected "$(IFS=,; echo "${preselected[*]}")" "${bundle_lines[@]}")" || exit 0
  mapfile -t bundles < <(printf 'base\n%s\n' "$(printf '%s\n' "$chosen_lines" | awk 'NF { print $1 }')" | awk 'NF && !seen[$0]++')
  echo
  if [[ -z "${PATINA_AI:-}" ]]; then
    ai_lines+=("$(printf '%-6s %s' none "No AI agent · patina ai on turns it on later")")
    for mode in local cloud; do
      b="$(ai_bundle "$mode")" || continue
      ai_lines+=("$(printf '%-6s %s' "$mode" "$(yq eval '.description' "$PATINA_PATH/manifest/bundles/$b.yaml")")")
    done
    choice="$(printf '%s\n' "${ai_lines[@]}" | grep "^$ai ")" || choice="${ai_lines[0]}"
    choice="$(gum choose --header "AI agent (Meta+A; it asks before it changes anything)" \
      --selected "$choice" "${ai_lines[@]}")" || exit 0
    ai="${choice%% *}"
    echo
  fi
  if [[ "$ai" == local && -z "${PATINA_AI_MODEL:-}" ]]; then
    mapfile -t model_lines < <(yq eval "[.ai.local.models[] | select(.min_memory_gb <= $(memory_gb))][] |
      (.model + \"|\" + .name)" "$PATINA_PATH/defaults/settings.yaml" | awk -F'|' '{ printf "%-24s %s\n", $1, $2 }')
    choice="$(printf '%s\n' "${model_lines[@]}" | grep "^$(local_model) ")" || choice="${model_lines[0]}"
    choice="$(gum choose --header "Local model ($(memory_gb) GB of memory; the first fits best)" \
      --selected "$choice" "${model_lines[@]}")" || exit 0
    PATINA_AI_MODEL="${choice%% *}"
    export PATINA_AI_MODEL
    echo
  fi
  if [[ "$ai" == cloud && -z "${PATINA_AI_PROVIDER:-}" ]]; then
    mapfile -t provider_lines < <(yq eval '.ai.cloud.providers[] | (.id + "|" + .name)' "$PATINA_PATH/defaults/settings.yaml" |
      awk -F'|' '{ printf "%-10s %s\n", $1, $2 }')
    choice="$(printf '%s\n' "${provider_lines[@]}" | grep "^$(cloud_provider) ")" || choice="${provider_lines[0]}"
    choice="$(gum choose --header "Cloud provider (the key stays in opencode's own login)" \
      --selected "$choice" "${provider_lines[@]}")" || exit 0
    PATINA_AI_PROVIDER="${choice%% *}"
    export PATINA_AI_PROVIDER
    echo
  fi
  gum style --border rounded --border-foreground "${tpl[ACCENT]}" --padding "1 3" \
    "$(printf 'theme    %s\nbundles  %s\nai       %s\nbackend  %s (%s)' "$PATINA_THEME" "${bundles[*]}" \
      "$(ai_summary)" "$(basename "$BACKEND" .yaml)" "$(uname -m)")"
  echo
  if ! gum confirm "Install now?" --affirmative Install --negative Cancel; then
    say "nothing changed"
    exit 0
  fi
  tui=1
}

# The cloud provider: PATINA_AI_PROVIDER, else the one the last install recorded, else
# the first of ai.cloud.providers.
cloud_provider() {
  local p="${PATINA_AI_PROVIDER:-}"
  [[ -n "$p" ]] || p="$(cat "$PATINA_STATE/ai-provider" 2> /dev/null || true)"
  [[ -n "$p" ]] || p="$(yq eval '.ai.cloud.providers[0].id' "$PATINA_PATH/defaults/settings.yaml")"
  echo "$p"
}

# This machine's memory in whole gigabytes, rounded.
memory_gb() {
  awk '/^MemTotal:/ { print int($2 / 1048576 + 0.5) }' /proc/meminfo
}

# The Ollama model: PATINA_AI_MODEL, else the one the last install recorded, else the
# first of ai.local.models whose memory fits this machine.
local_model() {
  local m="${PATINA_AI_MODEL:-}"
  [[ -n "$m" ]] || m="$(cat "$PATINA_STATE/ai-model" 2> /dev/null || true)"
  [[ -n "$m" ]] || m="$(yq eval "[.ai.local.models[] | select(.min_memory_gb <= $(memory_gb))][0].model // \"\"" \
    "$PATINA_PATH/defaults/settings.yaml")"
  echo "$m"
}

# The AI answer in words, for the summary.
ai_summary() {
  case "$ai" in
    local) echo "local, $(local_model) through Ollama" ;;
    cloud) echo "cloud, $(cloud_provider)" ;;
    *) echo none ;;
  esac
}

# Download to a file with curl, or wget while curl is not installed yet.
fetch() {
  if command -v curl > /dev/null; then
    curl -fsSL --retry 4 -o "$2" "$1"
  elif command -v wget > /dev/null; then
    wget -q -O "$2" "$1"
  else
    die "neither curl nor wget is installed; install curl first"
  fi
}

# yq cannot read its own recipe, so this is the one download a script spells out. The
# URL and the arch map must equal the yq entry of manifest/upstream.yaml; CI checks that.
bootstrap_yq() {
  have_go_yq && return
  local arch
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64) arch=arm64 ;;
    *) die "no yq build for $(uname -m)" ;;
  esac
  say "fetching the Go yq into ~/.local/bin"
  mkdir -p "$HOME/.local/bin"
  fetch "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${arch}" \
    "$HOME/.local/bin/yq"
  chmod +x "$HOME/.local/bin/yq"
  changed
  have_go_yq || die "yq was fetched but does not run; check ~/.local/bin/yq"
}

list_bundles() {
  local b f kind
  for b in $(all_bundles); do
    f="$PATINA_PATH/manifest/bundles/$b.yaml"
    kind=opt-in
    yq eval -e '.default == true' "$f" > /dev/null 2>&1 && kind=default
    yq eval -e '.required == true' "$f" > /dev/null 2>&1 && kind=always
    yq eval -e '.ai' "$f" > /dev/null 2>&1 && kind=ai
    printf '%-8s %-9s %s\n' "$b" "($kind)" "$(yq eval '.description' "$f")"
  done
}

install_packages() {
  local -a missing=()
  local p
  for p in "${packages[@]}"; do
    package_installed "$p" || missing+=("$p")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    say "packages: all ${#packages[@]} installed"
    return
  fi
  say "packages: installing ${missing[*]}"
  backend_run refresh
  backend_run install "${missing[@]}"
  changed
}

install_flatpaks() {
  [[ ${#flatpaks[@]} -gt 0 ]] || return 0
  local remote id
  remote="$(yq eval '.flatpak_remote' "$PATINA_PATH/defaults/settings.yaml")"
  # Per user, like the layer itself: no sudo, and Discover shows them all the same.
  if ! flatpak remotes --user --columns=name 2> /dev/null | grep -qx flathub; then
    say "flatpak: adding the Flathub remote for this user"
    flatpak remote-add --user --if-not-exists flathub "$remote"
    changed
  fi
  local missing=()
  for id in "${flatpaks[@]}"; do
    if flatpak_installed "$id"; then
      continue
    fi
    say "flatpak: installing $id"
    # One app that fails (no disk space, Flathub unreachable) does not stop the rest.
    if flatpak install --user --noninteractive --assumeyes flathub "$id"; then
      changed
    else
      missing+=("$id")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    warn "flatpaks: not installed: ${missing[*]}; check the disk space (df -h ~) and run patina install again"
    failed=1
    return
  fi
  say "flatpaks: all ${#flatpaks[@]} installed"
}

# Keyring and sources file of an apt-source recipe, written through the backend's one
# sudo path, as deb822 so no shell line is composed. Returns 0 when something changed.
add_apt_source() {
  local key="$1" name keyring keyurl sources_dir url suite components tmp dest changed_here=0
  name="$(yq eval ".$key.name" "$UPSTREAM")"
  keyring="$(yq eval ".$key.keyring" "$UPSTREAM")"
  keyurl="$(yq eval ".$key.key" "$UPSTREAM")"
  url="$(yq eval ".$key.source.url" "$UPSTREAM")"
  suite="$(yq eval ".$key.source.suite" "$UPSTREAM")"
  components="$(yq eval ".$key.source.components" "$UPSTREAM")"
  sources_dir="$(yq eval -e '.apt_source.sources_dir' "$BACKEND" 2> /dev/null)" ||
    die "$(basename "$BACKEND") cannot add apt sources; $key needs an apt base"
  tmp="$(mktemp)"
  fetch "$keyurl" "$tmp"
  if ! cmp -s "$tmp" "$keyring"; then
    say "$key: writing $keyring"
    backend_run system.write "$tmp" "$keyring"
    changed_here=1
  fi
  dest="$sources_dir/$name.sources"
  cat > "$tmp" << EOS
# Written by patina install from manifest/upstream.yaml ($key); edits are overwritten.
Types: deb
URIs: $url
Suites: $suite
Components: $components
Signed-By: $keyring
EOS
  if ! cmp -s "$tmp" "$dest"; then
    say "$key: writing $dest"
    backend_run system.write "$tmp" "$dest"
    changed_here=1
  fi
  rm -f "$tmp"
  [[ $changed_here -eq 1 ]]
}

install_upstream() {
  local key="$1" method command package url arch ref clone
  method="$(yq eval ".$key.method" "$UPSTREAM")"
  command="$(yq eval ".$key.command // \"\"" "$UPSTREAM")"
  package="$(yq eval ".$key.package // \"\"" "$UPSTREAM")"
  case "$method" in
    apt-source)
      # The sources are kept current even when the package is already installed.
      if add_apt_source "$key"; then
        backend_run refresh
        changed
      fi
      if ! upstream_installed "$key"; then
        say "$key: installing $package"
        backend_run install "$package"
        changed
      fi
      ;;
    *)
      if upstream_installed "$key"; then
        return
      fi
      say "$key: installing ($method)"
      mkdir -p "$HOME/.local/bin"
      case "$method" in
        binary)
          url="$(yq eval ".$key.url" "$UPSTREAM")"
          arch="$(yq eval -e ".$key.arch.$(uname -m)" "$UPSTREAM" 2> /dev/null)" ||
            die "$key has no build for $(uname -m)"
          fetch "${url//\$\{arch\}/$arch}" "$HOME/.local/bin/$command"
          chmod +x "$HOME/.local/bin/$command"
          ;;
        script)
          # The only `curl | sh` the conventions allow: an installer listed in
          # manifest/upstream.yaml.
          url="$(yq eval ".$key.url" "$UPSTREAM")"
          curl -fsSL --retry 4 "$url" | sh
          ;;
        npm)
          command -v npm > /dev/null || die "$key needs npm; the bundle must list nodejs and npm"
          npm install --global --prefix "$HOME/.local" "$package"
          ;;
        uv)
          command -v uv > /dev/null || install_upstream uv
          uv tool install "$package"
          ;;
        git)
          # The release's own install script does the installing, per user; the clone
          # is only its vehicle.
          url="$(yq eval ".$key.url" "$UPSTREAM")"
          ref="$(yq eval ".$key.ref" "$UPSTREAM")"
          clone="${XDG_CACHE_HOME:-$HOME/.cache}/patina/upstream/$key"
          rm -rf "$clone"
          git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$ref" "$url" "$clone"
          (cd "$clone" && "./$(yq eval ".$key.install" "$UPSTREAM")")
          rm -rf "$clone"
          mkdir -p "$PATINA_STATE/upstream"
          echo "$ref" > "$PATINA_STATE/upstream/$key"
          ;;
        *) die "unknown upstream method '$method' for $key" ;;
      esac
      changed
      ;;
  esac
}

# The system tuning: every file under defaults/system/ lands at the same path under
# /etc, through the backend's sudo path. The apply commands run once when a file
# changed and the machine is booted with systemd; a container gets the files only.
install_system() {
  local src rel dest changed_here=0 cmd first
  while IFS= read -r src; do
    rel="${src#"$PATINA_PATH/defaults/system/"}"
    dest="/etc/$rel"
    if cmp -s "$src" "$dest"; then
      continue
    fi
    say "system: writing $dest"
    backend_run system.write "$src" "$dest"
    changed_here=1
    changed
  done < <(find "$PATINA_PATH/defaults/system" -type f | sort)
  if [[ $changed_here -eq 0 ]]; then
    say "system: tuning files in place"
    return
  fi
  if ! booted_with_systemd; then
    say "system: not booted with systemd (a container?); the tuning applies at the next boot"
    return
  fi
  while IFS= read -r cmd; do
    first="${cmd#sudo }"
    first="${first%% *}"
    if ! command -v "$first" > /dev/null; then
      continue   # no GRUB on a Raspberry Pi, for instance
    fi
    if ! run_words "$cmd"; then
      warn "system: '$cmd' failed"
      failed=1
    fi
  done < <(yq eval '.system.apply[]' "$BACKEND")
}

# Settings merged into applications' own files, from defaults/apps.yaml, for the apps
# this install carries.
install_apps() {
  local apps="$PATINA_PATH/defaults/apps.yaml" app need file tmp merged
  for app in $(yq eval 'keys | .[]' "$apps"); do
    need="$(yq eval ".$app.requires.flatpak // \"\"" "$apps")"
    if [[ -n "$need" ]] && ! printf '%s\n' "${flatpaks[@]}" | grep -qx "$need"; then
      continue
    fi
    need="$(yq eval ".$app.requires.upstream // \"\"" "$apps")"
    if [[ -n "$need" ]] && ! printf '%s\n' "${upstream[@]}" | grep -qx "$need"; then
      continue
    fi
    file="$(yq eval ".$app.file" "$apps")"
    file="${file/#\~/$HOME}"
    tmp="$(mktemp)"
    yq eval -o=json ".$app.settings" "$apps" > "$tmp"
    if [[ -f "$file" ]]; then
      merged="$(mktemp)"
      if ! yq eval-all -o=json 'select(fileIndex == 0) * select(fileIndex == 1)' "$file" "$tmp" > "$merged" 2> /dev/null; then
        warn "$app: cannot parse $file (comments?); set these by hand: $(yq eval -o=json -I=0 '.' "$tmp")"
        rm -f "$tmp" "$merged"
        continue
      fi
      if ! cmp -s "$merged" "$file"; then
        say "$app: updating $file"
        cp "$merged" "$file"
        changed
      fi
      rm -f "$merged"
    else
      say "$app: writing $file"
      mkdir -p "$(dirname "$file")"
      cp "$tmp" "$file"
      changed
    fi
    rm -f "$tmp"
  done
}

# The AI agent the question chose: which model opencode uses, its standing instructions
# (defaults/agent.md), the local model pulled into Ollama or the cloud provider's login,
# which stays opencode's own. install_apps has written the rest of opencode's file.
install_ai() {
  local file="$HOME/.config/opencode/opencode.json" rules="$PATINA_PATH/defaults/agent.md"
  local model="" provider="" cloud_model="" tmp
  [[ -n "$ai" && "$ai" != none ]] || return 0
  if [[ "$ai" == local ]]; then
    model="$(local_model)"
    [[ -n "$model" ]] || die "no model of ai.local.models fits this machine"
  else
    provider="$(cloud_provider)"
    cloud_model="$(yq eval -e ".ai.cloud.providers[] | select(.id == \"$provider\") | .model // \"\"" \
      "$PATINA_PATH/defaults/settings.yaml" 2> /dev/null)" ||
      die "no cloud provider '$provider' in ai.cloud.providers of defaults/settings.yaml"
  fi
  mkdir -p "$(dirname "$file")"
  [[ -s "$file" ]] || echo '{}' > "$file"
  tmp="$(mktemp)"
  # A provider without a model of its own: opencode picks that provider's default.
  if ! MODEL="$model" PROVIDER="$provider" CLOUD_MODEL="$cloud_model" RULES="$rules" yq eval -o=json '
      .instructions = ((.instructions // []) + [strenv(RULES)] | unique) |
      with(select(strenv(MODEL) != "");
        .provider.ollama.models[strenv(MODEL)].name = strenv(MODEL) |
        .model = "ollama/" + strenv(MODEL)) |
      with(select(strenv(PROVIDER) != "");
        .model = strenv(CLOUD_MODEL) | del(.model | select(. == "")))
    ' "$file" > "$tmp" 2> /dev/null; then
    warn "opencode: cannot parse $file (comments?); set model and instructions by hand"
    rm -f "$tmp"
    failed=1
    return
  fi
  if ! cmp -s "$tmp" "$file"; then
    say "opencode: the $ai agent in $file"
    cp "$tmp" "$file"
    changed
  fi
  rm -f "$tmp"
  if [[ "$ai" == local ]]; then
    # `ollama list` names an untagged model with :latest.
    if ! ollama list > /dev/null 2>&1; then
      say "ai: Ollama is not running (a container?); later: ollama pull $model"
    elif ollama list | awk 'NR > 1 { print $1 }' | grep -qx "$model$([[ "$model" == *:* ]] || echo :latest)"; then
      say "ai: $model is in Ollama"
    else
      say "ai: pulling $model into Ollama (a few GB, once)"
      if ollama pull "$model"; then
        changed
      else
        # A newer model can need a newer Ollama than the one installed.
        warn "ai: pulling $model failed; update Ollama (its installer, manifest/upstream.yaml) and run: ollama pull $model"
        failed=1
      fi
    fi
  elif yq eval -e ".\"$provider\"" "$HOME/.local/share/opencode/auth.json" > /dev/null 2>&1; then
    say "ai: opencode is logged in to $provider"
  elif [[ -t 0 && -t 1 && -z "$PATINA_UNATTENDED" ]]; then
    say "ai: log in to $provider; opencode keeps the key, patina never sees it"
    opencode auth login --provider "$provider" ||
      say "ai: not logged in; later: opencode auth login --provider $provider"
  else
    say "ai: log in once with: opencode auth login --provider $provider"
  fi
}

# The theme, through `patina theme set`: PATINA_THEME, else the one already recorded,
# else the default of defaults/settings.yaml. The first install also gives the desktop
# the theme's panel layout (Plasma's stock bar is all that exists then); later runs
# leave the panels alone. Counts as a change when a renderer changed something.
install_theme() {
  local theme out
  local -a flags=()
  theme="${PATINA_THEME:-}"
  [[ -n "$theme" ]] || theme="$(current_theme || yq eval '.theme' "$PATINA_PATH/defaults/settings.yaml")"
  [[ $first_install -eq 0 ]] || flags+=(--layout)
  out="$(mktemp)"
  if ! "$PATINA_PATH/bin/patina-theme" set "$theme" "${flags[@]}" | tee "$out"; then
    warn "theme: '$theme' failed to apply"
    failed=1
  fi
  if grep -q ' change(s)' "$out"; then
    changed
  fi
  rm -f "$out"
}

record_state() {
  local m
  mkdir -p "$PATINA_STATE/migrations"
  # Nothing is ever removed, so the record is every bundle installed so far; doctor
  # checks them all.
  { [[ -f "$PATINA_STATE/bundles" ]] && cat "$PATINA_STATE/bundles"; printf '%s\n' "${bundles[@]}"; } |
    awk 'NF && !seen[$0]++' > "$PATINA_STATE/bundles.new"
  mv "$PATINA_STATE/bundles.new" "$PATINA_STATE/bundles"
  # The AI answer, offered first next time; none too, so the question remembers it.
  if [[ -n "$ai" ]]; then
    echo "$ai" > "$PATINA_STATE/ai"
    [[ "$ai" != cloud ]] || cloud_provider > "$PATINA_STATE/ai-provider"
    [[ "$ai" != local ]] || local_model > "$PATINA_STATE/ai-model"
  fi
  if [[ $first_install -eq 1 ]]; then
    # A fresh install is the end state every migration leads to, so none is pending.
    for m in "$PATINA_PATH"/migrations/[0-9]*.sh; do
      [[ -e "$m" ]] || continue
      date -u +%FT%TZ > "$PATINA_STATE/migrations/$(basename "$m")"
    done
    date -u +%FT%TZ > "$PATINA_STATE/installed-at"
  fi
}

main() {
  local chosen="" all=0 list=0 b
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bundles)
        [[ $# -ge 2 ]] || die "--bundles needs a list"
        chosen="$2"
        shift 2
        ;;
      --bundles=*)
        chosen="${1#*=}"
        shift
        ;;
      --all)
        all=1
        shift
        ;;
      --list)
        list=1
        shift
        ;;
      --unattended)
        PATINA_UNATTENDED=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        die "unknown option '$1'"
        ;;
    esac
  done
  export PATINA_UNATTENDED="${PATINA_UNATTENDED:-}"

  [[ -e "$PATINA_STATE/installed-at" ]] || first_install=1
  bootstrap_yq
  if [[ $list -eq 1 ]]; then
    list_bundles
    exit 0
  fi
  BACKEND="$(backend_file)"
  UPSTREAM="$PATINA_PATH/manifest/upstream.yaml"

  # The AI answer: local, cloud, none, or empty when --bundles leaves the agent alone.
  ai="$(current_ai)"
  bundles=()
  if [[ $all -eq 1 ]]; then
    mapfile -t bundles < <(all_bundles)
    [[ "$ai" != none ]] || ai=local
  elif [[ -n "$chosen" ]]; then
    mapfile -t bundles < <(printf 'base\n%s\n' "${chosen//,/$'\n'}" | awk 'NF && !seen[$0]++')
    [[ -n "${PATINA_AI:-}" ]] || ai=""
    for b in "${bundles[@]}"; do
      [[ -f "$PATINA_PATH/manifest/bundles/$b.yaml" ]] || die "no bundle '$b' (try --list)"
      [[ -n "${PATINA_AI:-}" ]] || ai="$(yq eval ".ai // \"$ai\"" "$PATINA_PATH/manifest/bundles/$b.yaml")"
    done
  else
    mapfile -t bundles < <(default_bundles)
    if [[ -t 0 && -t 1 && -z "$PATINA_UNATTENDED" ]] && command -v gum > /dev/null; then
      ask
    fi
  fi
  if [[ -n "$ai" && "$ai" != none ]]; then
    b="$(ai_bundle "$ai")" || die "no bundle in manifest/bundles/ answers ai: $ai"
    mapfile -t bundles < <(printf '%s\n' "${bundles[@]}" "$b" | awk 'NF && !seen[$0]++')
  fi
  say "bundles: ${bundles[*]} ($(basename "$BACKEND" .yaml) backend, $(uname -m))"

  mapfile -t packages < <(bundle_items packages "${bundles[@]}")
  mapfile -t flatpaks < <(bundle_items flatpaks "${bundles[@]}")
  mapfile -t upstream < <(bundle_items upstream "${bundles[@]}")

  section packages
  install_packages
  section flatpaks
  install_flatpaks
  section upstream
  for b in "${upstream[@]}"; do
    install_upstream "$b"
  done
  section system
  install_system
  install_apps
  section "ai agent"
  install_ai
  record_state
  section theme
  install_theme

  if [[ $failed -ne 0 ]]; then
    die "finished with errors (see above)"
  fi
  if [[ $changes -eq 0 ]]; then
    say "nothing to do"
  else
    say "done: $changes changes"
  fi
}

main "$@"
