#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Install the layer: the chosen bundles (packages through this base's backend, flatpaks
# from Flathub, the upstream recipes), the system tuning, the app settings, the AI agent
# and the theme, all from the data files. Idempotent: a second run changes nothing and
# says so.
set -euo pipefail

# shellcheck source=bin/lib.sh
source "$PATINA_PATH/bin/lib.sh"

usage() {
  cat << EOU
usage: patina install [--bundles <a,b,...>] [--all] [--list] [--unattended]

  --bundles a,b  install these bundles; base is always included, and nothing already
                 installed is removed. Default: the bundles installed here so far, or
                 the bundles marked default before the first install
  --all          every bundle, the opt-in ones (agents) included
  --list         show the bundles and exit
  --unattended   no questions, defaults for everything (same as PATINA_UNATTENDED=1):
                 the contract the image's first boot and CI use

On a terminal, without --bundles or --all, the install asks (with gum): the theme, the
app bundles, the AI agent, then a summary and a yes. The theme: PATINA_THEME=<name>
picks one (patina theme list) and skips that question; otherwise the theme already set
on this machine, or the default of defaults/settings.yaml, is offered first.

The AI agent: PATINA_AI_AGENT=opencode|hermes picks the agent (none: no agent, whatever
PATINA_AI says) and PATINA_AI=local|cloud|none where its model runs; PATINA_AI_MODEL=<tag>
the local model and PATINA_AI_PROVIDER=<id> the cloud provider (ai.local and ai.cloud in
defaults/settings.yaml); otherwise the answers of the last install, or ai.agent and
ai.mode, are offered first and taken when unattended. --bundles adds an agent only when
it names an AI bundle (ai-local, ai-cloud, hermes-local, hermes-cloud).

The install asks for no cloud provider and no key: a cloud agent keeps the provider it
had, or the first of ai.cloud.providers, until patina ai login (the welcome's first step
at the next login) picks one and logs in.
EOU
}

changes=0
failed=0
tui=0
first_install=0

changed() {
  changes=$((changes + 1))
}

# A section line before each part of the install, only when the questions were asked;
# unattended output stays as it is.
section() {
  [[ $tui -eq 1 ]] || return 0
  echo
  gum style --bold --foreground "${tpl[ACCENT]}" "── $1 ──"
}

# The questions, on a terminal: the theme, the app bundles, the AI agent and where its
# model runs, a summary and a yes. Sets PATINA_THEME, bundles, agent, ai and
# PATINA_AI_MODEL; a cloud agent's provider and key are patina ai login's. Each question
# goes one back with Ctrl+C or its Back line (pick in lib.sh); the first leaves without
# a change. What this machine has is marked "(now)", since pick's lists preselect none,
# and the bundles are a list whose lines Enter turns on and off, the defaults on.
ask() {
  local current d mode name kind choice b step=theme now line back
  local ask_theme=0 ask_ai=0 ask_model=0
  local -a lines=() asked=() names=()
  local -A on=() about=()
  current="${PATINA_THEME:-$(current_theme || yq eval '.theme' "$PATINA_PATH/defaults/settings.yaml")}"
  d="$(theme_dir "$current")" || die "no theme '$current' under themes/ (try patina theme list)"
  mode="$(current_mode)"
  theme_vars "$d/theme.yaml" "$PATINA_PATH/defaults/settings.yaml" "$mode"
  tui_colors
  print_wordmark auto "${tpl[VARIANT]}"
  echo
  gum style --foreground "${tpl[BASE04]}" \
    "patina $("$PATINA_PATH/bin/patina" version) · $(basename "$BACKEND" .yaml) · $(uname -m)"
  echo
  [[ -n "${PATINA_THEME:-}" ]] || ask_theme=1
  [[ -n "${PATINA_AI:-}" ]] || ask_ai=1
  [[ -n "${PATINA_AI_MODEL:-}" ]] || ask_model=1
  for name in $(all_bundles); do
    yq eval -e '.required == true or .ai' "$PATINA_PATH/manifest/bundles/$name.yaml" > /dev/null 2>&1 && continue
    kind="opt-in"
    yq eval -e '.default == true' "$PATINA_PATH/manifest/bundles/$name.yaml" > /dev/null 2>&1 && kind="default"
    names+=("$name")
    about[$name]="$(printf '%-8s %s' "($kind)" "$(yq eval '.description' "$PATINA_PATH/manifest/bundles/$name.yaml")")"
    [[ " ${bundles[*]} " != *" $name "* ]] || on[$name]=1
  done
  while true; do
    # The first question asked leaves; every other goes back to the one before it.
    back="← Back"
    [[ ${#asked[@]} -gt 0 ]] || back="← Leave · nothing changes"
    case "$step" in
      theme)
        step=bundles
        [[ $ask_theme -eq 1 ]] || continue
        mapfile -t lines < <("$PATINA_PATH/bin/patina-theme" list | sed 's/^[* ] //')
        mapfile -t lines < <(mark_now "$(current_theme || true)" "${lines[@]}")
        if ! choice="$(pick --back "$back" "Theme" "${lines[@]}")"; then
          say "nothing changed"
          exit 0
        fi
        PATINA_THEME="${choice%% *}"
        export PATINA_THEME
        asked+=(theme)
        ;;
      bundles)
        lines=("$(printf '%-9s %s' next "Go on with base$(for name in "${names[@]}"; do
          [[ -z "${on[$name]:-}" ]] || printf ', %s' "$name"
        done)")")
        for name in "${names[@]}"; do
          line="[ ]"
          [[ -z "${on[$name]:-}" ]] || line="[x]"
          lines+=("$(printf '%-9s %s %s' "$name" "$line" "${about[$name]}")")
        done
        if ! choice="$(pick --back "$back" "App bundles (Enter turns one on or off)" "${lines[@]}")"; then
          if [[ ${#asked[@]} -eq 0 ]]; then
            say "nothing changed"
            exit 0
          fi
          step="${asked[-1]}"
          unset 'asked[-1]'
          continue
        fi
        name="${choice%% *}"
        if [[ "$name" != next ]]; then
          if [[ -n "${on[$name]:-}" ]]; then unset 'on[$name]'; else on[$name]=1; fi
          continue
        fi
        bundles=(base)
        for name in "${names[@]}"; do
          [[ -z "${on[$name]:-}" ]] || bundles+=("$name")
        done
        asked+=(bundles)
        step=agent
        ;;
      agent)
        step=mode
        [[ $ask_ai -eq 1 ]] || continue
        lines=("$(printf '%-9s %s' none "No AI agent · patina ai on turns it on later")")
        mapfile -t -O 1 lines < <(agent_lines)
        now=""
        if [[ -s "$PATINA_STATE/ai" ]]; then
          now="$(cat "$PATINA_STATE/ai")"
          [[ "$now" == none ]] || now="$(cat "$PATINA_STATE/ai-agent" 2> /dev/null || echo opencode)"
        fi
        mapfile -t lines < <(mark_now "$now" "${lines[@]}")
        if ! choice="$(pick --back "$back" "AI agent (Meta+A, and ai in the command palette)" "${lines[@]}")"; then
          step="${asked[-1]}"
          unset 'asked[-1]'
          continue
        fi
        choice="${choice%% *}"
        asked+=(agent)
        if [[ "$choice" == none ]]; then
          ai=none
          step=summary
        else
          agent="$choice"
        fi
        ;;
      mode)
        step=model
        [[ $ask_ai -eq 1 ]] || continue
        lines=()
        for mode in local cloud; do
          b="$(ai_bundle "$mode" "$agent")" || continue
          lines+=("$(printf '%-6s %s' "$mode" "$(yq eval '.description' "$PATINA_PATH/manifest/bundles/$b.yaml")")")
        done
        now=""
        [[ "$agent" != "$(cat "$PATINA_STATE/ai-agent" 2> /dev/null || true)" ]] ||
          now="$(cat "$PATINA_STATE/ai" 2> /dev/null || true)"
        mapfile -t lines < <(mark_now "$now" "${lines[@]}")
        if ! choice="$(pick --back "$back" "Where its model runs" "${lines[@]}")"; then
          step="${asked[-1]}"
          unset 'asked[-1]'
          continue
        fi
        ai="${choice%% *}"
        asked+=(mode)
        ;;
      model)
        step=summary
        [[ "$ai" == local && $ask_model -eq 1 ]] || continue
        # A small model carries its hint: it gets commands and facts wrong more often.
        mapfile -t lines < <(yq eval ".ai.local.small_hint as \$h | [.ai.local.models[] |
          select(.min_memory_gb <= $(memory_gb))][] | (.model + \"|\" + .name +
          (if .small then \" · \" + \$h else \"\" end))" "$PATINA_PATH/defaults/settings.yaml" |
          awk -F'|' '{ printf "%-24s %s\n", $1, $2 }')
        mapfile -t lines < <(mark_now "$(cat "$PATINA_STATE/ai-model" 2> /dev/null || true)" "${lines[@]}")
        if ! choice="$(pick --back "$back" "Local model ($(memory_gb) GB of memory; the first fits best)" "${lines[@]}")"; then
          step="${asked[-1]}"
          unset 'asked[-1]'
          continue
        fi
        PATINA_AI_MODEL="${choice%% *}"
        export PATINA_AI_MODEL
        asked+=(model)
        ;;
      summary)
        gum style --border rounded --border-foreground "${tpl[ACCENT]}" --padding "1 3" \
          "$(printf 'theme    %s\nbundles  %s\nai       %s\nbackend  %s (%s)' "$PATINA_THEME" "${bundles[*]}" \
            "$(ai_summary)" "$(basename "$BACKEND" .yaml)" "$(uname -m)")"
        if pick "Install now?" "Install now" > /dev/null; then
          break
        fi
        step="${asked[-1]}"
        unset 'asked[-1]'
        ;;
    esac
  done
  tui=1
}

# This machine's memory in whole gigabytes, rounded.
memory_gb() {
  awk '/^MemTotal:/ { print int($2 / 1048576 + 0.5) }' /proc/meminfo
}

# The Ollama model: PATINA_AI_MODEL, else the one the last install recorded, else the
# first of ai.local.models whose memory fits this machine.
local_model() {
  local m="${PATINA_AI_MODEL:-}"
  [[ -n "$m" ]] || m="$(cat "$PATINA_STATE/ai-model" 2> /dev/null || true)"
  [[ -n "$m" ]] || m="$(yq eval "[.ai.local.models[] | select(.min_memory_gb <= $(memory_gb))][0].model // \"\"" \
    "$PATINA_PATH/defaults/settings.yaml")"
  echo "$m"
}

# The AI answer in words, for the summary.
ai_summary() {
  local p
  case "$ai" in
    local) echo "$agent, local, $(local_model) through Ollama$(small_hint "$(local_model)")" ;;
    cloud)
      p="$(cloud_provider "$agent")"
      if ai_logged_in "$agent" "$p"; then
        echo "$agent, cloud, $(P="$p" yq eval '.ai.cloud.providers[] | select(.id == strenv(P)) | .name' \
          "$PATINA_PATH/defaults/settings.yaml")"
      else
        echo "$agent, cloud (provider and key at the next login, in the welcome)"
      fi
      ;;
    *) echo none ;;
  esac
}

# Download to a file with curl, or wget while curl is not installed yet.
fetch() {
  if command -v curl > /dev/null; then
    curl -fsSL --retry 4 -o "$2" "$1"
  elif command -v wget > /dev/null; then
    wget -q -O "$2" "$1"
  else
    die "neither curl nor wget is installed; install curl first"
  fi
}

# yq cannot read its own recipe, so this is the one download a script spells out. The
# URL and the arch map must equal the yq entry of manifest/upstream.yaml; CI checks that.
bootstrap_yq() {
  have_go_yq && return
  local arch
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64) arch=arm64 ;;
    *) die "no yq build for $(uname -m)" ;;
  esac
  say "fetching the Go yq into ~/.local/bin"
  mkdir -p "$HOME/.local/bin"
  fetch "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${arch}" \
    "$HOME/.local/bin/yq"
  chmod +x "$HOME/.local/bin/yq"
  changed
  have_go_yq || die "yq was fetched but does not run; check ~/.local/bin/yq"
}

list_bundles() {
  local b f kind width=0
  # The names in a column as wide as the longest (hermes-local is wider than eight).
  for b in $(all_bundles); do
    (( ${#b} <= width )) || width=${#b}
  done
  for b in $(all_bundles); do
    f="$PATINA_PATH/manifest/bundles/$b.yaml"
    kind=opt-in
    yq eval -e '.default == true' "$f" > /dev/null 2>&1 && kind=default
    yq eval -e '.required == true' "$f" > /dev/null 2>&1 && kind=always
    yq eval -e '.ai' "$f" > /dev/null 2>&1 && kind=ai
    printf '%-*s %-9s %s\n' "$width" "$b" "($kind)" "$(yq eval '.description' "$f")"
  done
}

install_packages() {
  local -a missing=()
  local p
  for p in "${packages[@]}"; do
    package_installed "$p" || missing+=("$p")
  done
  if [[ ${#missing[@]} -eq 0 ]]; then
    say "packages: all ${#packages[@]} installed"
    return
  fi
  say "packages: installing ${missing[*]}"
  backend_run refresh
  backend_run install "${missing[@]}"
  changed
}

install_flatpaks() {
  [[ ${#flatpaks[@]} -gt 0 ]] || return 0
  local remote id
  remote="$(yq eval '.flatpak_remote' "$PATINA_PATH/defaults/settings.yaml")"
  # Per user, like the layer itself: no sudo, and Discover shows them all the same.
  if ! flatpak remotes --user --columns=name 2> /dev/null | grep -qx flathub; then
    say "flatpak: adding the Flathub remote for this user"
    flatpak remote-add --user --if-not-exists flathub "$remote"
    changed
  fi
  local missing=()
  for id in "${flatpaks[@]}"; do
    if flatpak_installed "$id"; then
      continue
    fi
    say "flatpak: installing $id"
    # One app that fails (no disk space, Flathub unreachable) does not stop the rest.
    if flatpak install --user --noninteractive --assumeyes flathub "$id"; then
      changed
    else
      missing+=("$id")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    warn "flatpaks: not installed: ${missing[*]}; check the disk space (df -h ~) and run patina install again"
    failed=1
    return
  fi
  say "flatpaks: all ${#flatpaks[@]} installed"
}

# Keyring and sources file of an apt-source recipe, written through the backend's one
# sudo path, as deb822 so no shell line is composed. Returns 0 when something changed.
add_apt_source() {
  local key="$1" name keyring keyurl sources_dir url suite components tmp dest changed_here=0
  name="$(yq eval ".$key.name" "$UPSTREAM")"
  keyring="$(yq eval ".$key.keyring" "$UPSTREAM")"
  keyurl="$(yq eval ".$key.key" "$UPSTREAM")"
  url="$(yq eval ".$key.source.url" "$UPSTREAM")"
  suite="$(yq eval ".$key.source.suite" "$UPSTREAM")"
  components="$(yq eval ".$key.source.components" "$UPSTREAM")"
  sources_dir="$(yq eval -e '.apt_source.sources_dir' "$BACKEND" 2> /dev/null)" ||
    die "$(basename "$BACKEND") cannot add apt sources; $key needs an apt base"
  tmp="$(mktemp)"
  # This runs as a condition, where set -e does not stop it: a failed download would
  # replace a good keyring with an empty file, and apt would refuse the source.
  if ! fetch "$keyurl" "$tmp"; then
    [[ -s "$keyring" ]] || die "$key: cannot download its signing key from $keyurl"
    warn "$key: cannot download its signing key now; keeping $keyring"
  elif ! cmp -s "$tmp" "$keyring"; then
    say "$key: writing $keyring"
    backend_run system.write "$tmp" "$keyring"
    changed_here=1
  fi
  dest="$sources_dir/$name.sources"
  cat > "$tmp" << EOS
# Written by patina install from manifest/upstream.yaml ($key); edits are overwritten.
Types: deb
URIs: $url
Suites: $suite
Components: $components
Signed-By: $keyring
EOS
  if ! cmp -s "$tmp" "$dest"; then
    say "$key: writing $dest"
    backend_run system.write "$tmp" "$dest"
    changed_here=1
  fi
  rm -f "$tmp"
  [[ $changed_here -eq 1 ]]
}

install_upstream() {
  local key="$1" method command package url arch ref clone
  local -a args
  method="$(yq eval ".$key.method" "$UPSTREAM")"
  command="$(yq eval ".$key.command // \"\"" "$UPSTREAM")"
  package="$(yq eval ".$key.package // \"\"" "$UPSTREAM")"
  case "$method" in
    apt-source)
      # The sources are kept current even when the package is already installed.
      if add_apt_source "$key"; then
        backend_run refresh
        changed
      fi
      if ! upstream_installed "$key"; then
        say "$key: installing $package"
        backend_run install "$package"
        changed
      fi
      ;;
    *)
      if upstream_installed "$key"; then
        return
      fi
      say "$key: installing ($method)"
      mkdir -p "$HOME/.local/bin"
      case "$method" in
        binary)
          url="$(yq eval ".$key.url" "$UPSTREAM")"
          arch="$(yq eval -e ".$key.arch.$(uname -m)" "$UPSTREAM" 2> /dev/null)" ||
            die "$key has no build for $(uname -m)"
          fetch "${url//\$\{arch\}/$arch}" "$HOME/.local/bin/$command"
          chmod +x "$HOME/.local/bin/$command"
          ;;
        script)
          # The only `curl | sh` the conventions allow: an installer listed in
          # manifest/upstream.yaml, with its arguments.
          url="$(yq eval ".$key.url" "$UPSTREAM")"
          mapfile -t args < <(yq eval ".$key.args // [] | .[]" "$UPSTREAM")
          curl -fsSL --retry 4 "$url" | bash -s -- "${args[@]}"
          ;;
        npm)
          command -v npm > /dev/null || die "$key needs npm; the bundle must list nodejs and npm"
          npm install --global --prefix "$HOME/.local" "$package"
          ;;
        uv)
          command -v uv > /dev/null || install_upstream uv
          uv tool install "$package"
          ;;
        git)
          # The release's own install script does the installing, per user; the clone
          # is only its vehicle.
          url="$(yq eval ".$key.url" "$UPSTREAM")"
          ref="$(yq eval ".$key.ref" "$UPSTREAM")"
          clone="${XDG_CACHE_HOME:-$HOME/.cache}/patina/upstream/$key"
          rm -rf "$clone"
          git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$ref" "$url" "$clone"
          (cd "$clone" && "./$(yq eval ".$key.install" "$UPSTREAM")")
          rm -rf "$clone"
          mkdir -p "$PATINA_STATE/upstream"
          echo "$ref" > "$PATINA_STATE/upstream/$key"
          ;;
        *) die "unknown upstream method '$method' for $key" ;;
      esac
      changed
      ;;
  esac
}

# The system tuning: every file under defaults/system/, and under system/ of a detected
# device, lands at the same path under /etc, through the backend's sudo path; a file a
# bundle names (`system:`) only while the machine has such a bundle, the ones it records
# or this run installs, and it goes again once none is left (`patina ai off`). The apply
# commands run once when a file changed and the machine is booted with systemd; a
# container gets the files only.
install_system() {
  local dir src dest changed_here=0 cmd first d splash menu wallpaper stamp out n
  local -a dirs=("$PATINA_PATH/defaults/system") held=() unwanted=()
  for d in "${devices[@]}"; do
    [[ ! -d "$PATINA_PATH/devices/$d/system" ]] || dirs+=("$PATINA_PATH/devices/$d/system")
  done
  mapfile -t held < <( { recorded_bundles; printf '%s\n' "${bundles[@]}"; } | awk 'NF && !seen[$0]++')
  mapfile -t unwanted < <(system_unwanted "${held[@]}")
  for dir in "${dirs[@]}"; do
    while IFS= read -r src; do
      dest="/etc/${src#"$dir/"}"
      if [[ "$dir" == "$PATINA_PATH/defaults/system" ]] && printf '%s\n' "${unwanted[@]}" | grep -qxF "${src#"$dir/"}"; then
        # Only what patina wrote goes: sudo's own files by the checksum kept of them,
        # since one of that name may be an admin's, any other by being its source.
        if [[ -f "$PATINA_STATE/system$dest.sha256" ]] || { [[ "$dest" != /etc/sudoers.d/* ]] && cmp -s "$src" "$dest"; }; then
          say "system: removing $dest (no bundle of this machine names it)"
          backend_run system.remove "$dest"
          rm -f "$PATINA_STATE/system$dest.sha256"
          changed
        fi
        continue
      fi
      if system_in_place "$src" "$dest"; then
        continue
      fi
      if [[ "$dest" == /etc/sudoers.d/* ]]; then
        # A file sudo cannot parse leaves the machine without sudo, so visudo reads it
        # first. sudo reads it at each run: nothing to apply.
        if PATH="$PATH:/usr/sbin:/sbin" command -v visudo > /dev/null &&
          ! PATH="$PATH:/usr/sbin:/sbin" visudo -cqf "$src"; then
          warn "system: visudo rejects $src; $dest left as it is"
          failed=1
          continue
        fi
        say "system: writing $dest"
        backend_run system.write_private "$src" "$dest"
        mkdir -p "$(dirname "$PATINA_STATE/system$dest")"
        sha256sum < "$src" | cut -d ' ' -f 1 > "$PATINA_STATE/system$dest.sha256"
        changed
        continue
      fi
      say "system: writing $dest"
      # A script the system runs (a device's /etc/grub.d entry) stays executable.
      if [[ -x "$src" ]]; then
        backend_run system.write_script "$src" "$dest"
      else
        backend_run system.write "$src" "$dest"
      fi
      changed_here=1
      changed
    done < <(find "$dir" -type f | sort)
  done
  # The boot splash (defaults/boot/), where Plymouth looks for its themes, through the
  # same path; the apply commands below put it into the initramfs. Drawing its 88
  # pictures takes a while, so it is drawn only when what it is drawn from changed: a
  # checksum of that sits beside it.
  splash=/usr/share/plymouth/themes/patina
  stamp="$( {
    cat "$PATINA_PATH/branding/logo.txt" "$PATINA_PATH"/defaults/boot/*.svg \
      "$PATINA_PATH/defaults/boot/patina.plymouth" "$PATINA_PATH/defaults/settings.yaml" \
      "$PATINA_PATH/themes/$(yq eval '.theme' "$PATINA_PATH/defaults/settings.yaml")/theme.yaml"
    declare -f render_boot_splash
  } | sha256sum | cut -d ' ' -f 1)"
  if [[ "$(cat "$splash/source.sha256" 2> /dev/null)" != "$stamp" ]]; then
    if command -v rsvg-convert > /dev/null; then
      out="$(mktemp -d)"
      ( render_boot_splash "$out" )
      echo "$stamp" > "$out/source.sha256"
      n=0
      for src in "$out"/*; do
        cmp -s "$src" "$splash/${src##*/}" && continue
        backend_run system.write "$src" "$splash/${src##*/}"
        n=$((n + 1))
      done
      rm -rf "$out"
      say "system: boot splash drawn, $n files in $splash"
      changed_here=1
      changed
    else
      warn "rsvg-convert is missing (librsvg2-bin in the base bundle); no boot splash"
    fi
  fi
  # The boot menu (defaults/boot/grub/), where GRUB_THEME of default/grub.d/patina.cfg
  # points: under /boot/grub, which GRUB reads wherever the system lies (a /boot of its
  # own, an encrypted root). Only where GRUB is (grub-mkfont comes with it), drawn
  # again only when what it is drawn from changed, as the splash; update-grub below
  # takes it into GRUB's configuration.
  menu=/boot/grub/themes/patina
  if command -v grub-mkfont > /dev/null; then
    wallpaper="$(theme_vars "$PATINA_PATH/themes/$(yq eval '.theme' "$PATINA_PATH/defaults/settings.yaml")/theme.yaml" \
      "$PATINA_PATH/defaults/settings.yaml" dark && echo "${tpl[WALLPAPER_FIRST]}")"
    stamp="$( {
      cat "$PATINA_PATH"/defaults/boot/grub/* "$PATINA_PATH/branding/export/wordmark-blocks.svg" \
        "$PATINA_PATH/defaults/settings.yaml" "$wallpaper"
      declare -f render_boot_menu raster_wallpaper
    } | sha256sum | cut -d ' ' -f 1)"
    if [[ "$(cat "$menu/source.sha256" 2> /dev/null)" != "$stamp" ]]; then
      if command -v rsvg-convert > /dev/null && command -v fc-match > /dev/null; then
        out="$(mktemp -d)"
        ( render_boot_menu "$out" )
        echo "$stamp" > "$out/source.sha256"
        n=0
        for src in "$out"/*; do
          cmp -s "$src" "$menu/${src##*/}" && continue
          backend_run system.write "$src" "$menu/${src##*/}"
          n=$((n + 1))
        done
        rm -rf "$out"
        say "system: boot menu drawn, $n files in $menu"
        changed_here=1
        changed
      else
        warn "rsvg-convert or fc-match is missing (the base bundle); no boot menu theme"
      fi
    fi
  fi
  if [[ $changed_here -eq 0 ]]; then
    say "system: tuning files in place"
    return
  fi
  if ! booted_with_systemd; then
    say "system: not booted with systemd (a container?); the tuning applies at the next boot"
    return
  fi
  while IFS= read -r cmd; do
    first="${cmd#sudo }"
    first="${first%% *}"
    # sudo finds commands in the sbin directories, which a Debian user's PATH lacks
    # (sysctl, update-initramfs, update-grub), so they are looked for there too.
    if ! PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin" command -v "$first" > /dev/null; then
      continue   # no GRUB on a Raspberry Pi, for instance
    fi
    if ! run_words "$cmd"; then
      warn "system: '$cmd' failed"
      failed=1
    fi
  done < <(yq eval '.system.apply[]' "$BACKEND")
}

# Settings merged into applications' own files, from defaults/apps.yaml, for the apps
# this install carries.
install_apps() {
  local apps="$PATINA_PATH/defaults/apps.yaml" app need file tmp merged
  for app in $(yq eval 'keys | .[]' "$apps"); do
    need="$(yq eval ".$app.requires.flatpak // \"\"" "$apps")"
    if [[ -n "$need" ]] && ! printf '%s\n' "${flatpaks[@]}" | grep -qx "$need"; then
      continue
    fi
    need="$(yq eval ".$app.requires.upstream // \"\"" "$apps")"
    if [[ -n "$need" ]] && ! printf '%s\n' "${upstream[@]}" | grep -qx "$need"; then
      continue
    fi
    file="$(yq eval ".$app.file" "$apps")"
    file="${file/#\~/$HOME}"
    tmp="$(mktemp)"
    yq eval -o=json ".$app.settings" "$apps" > "$tmp"
    if [[ -f "$file" ]]; then
      merged="$(mktemp)"
      # Ours over theirs over ours: the values are patina's, the user's other keys stay,
      # and patina's keys keep their order in apps.yaml with the user's after them, as
      # rules where the last match wins (opencode's permissions) need.
      if ! yq eval-all -o=json 'select(fileIndex == 1) * select(fileIndex == 0) * select(fileIndex == 1)' \
          "$file" "$tmp" > "$merged" 2> /dev/null; then
        warn "$app: cannot parse $file (comments?); set these by hand: $(yq eval -o=json -I=0 '.' "$tmp")"
        rm -f "$tmp" "$merged"
        continue
      fi
      if ! cmp -s "$merged" "$file"; then
        say "$app: updating $file"
        cp "$merged" "$file"
        changed
      fi
      rm -f "$merged"
    else
      say "$app: writing $file"
      mkdir -p "$(dirname "$file")"
      cp "$tmp" "$file"
      changed
    fi
    rm -f "$tmp"
  done
}

# Your own API's address and model (the `custom` provider), as patina ai login recorded
# them: endpoint_value url|model
endpoint_value() {
  yq eval ".$1 // \"\"" "$PATINA_STATE/ai-endpoint.yaml" 2> /dev/null || true
}

# opencode: which model it uses and its standing instructions (defaults/agent.md); for
# your own API the provider `custom`, with the address and model patina ai login
# recorded and the key from the file it wrote, readable by the user only. A cloud
# provider's key is opencode's own login, which patina ai login runs: nothing is asked
# here. install_apps has written the rest of opencode's file.
install_opencode() {
  local file="$HOME/.config/opencode/opencode.json" rules="$PATINA_PATH/defaults/agent.md"
  local keyfile="${XDG_CONFIG_HOME:-$HOME/.config}/patina/ai/custom.key"
  local model local_tag="" provider="" url="" custom="" host="" tmp name
  if [[ "$ai" == local ]]; then
    local_tag="$(local_model)"
    [[ -n "$local_tag" ]] || die "no model of ai.local.models fits this machine"
    model="ollama/$local_tag"
  else
    provider="$(cloud_provider opencode)"
    if [[ "$(provider_login "$provider")" == endpoint ]]; then
      url="$(endpoint_value url)"
      custom="$(endpoint_value model)"
      [[ -n "$url" && -n "$custom" ]] || die "your own API has no address yet: patina ai login asks for it"
      host="${url#*://}"
      host="${host%%/*}"
      model="custom/$custom"
    else
      model="$(P="$provider" yq eval '.ai.cloud.providers[] | select(.id == strenv(P)) | .model // ""' \
        "$PATINA_PATH/defaults/settings.yaml")"
      [[ -n "$model" ]] || die "the cloud provider '$provider' has no model in ai.cloud.providers of defaults/settings.yaml"
    fi
  fi
  mkdir -p "$(dirname "$file")"
  [[ -s "$file" ]] || echo '{}' > "$file"
  tmp="$(mktemp)"
  # The model always: without one opencode took the first model it knew, Ollama's.
  if ! MODEL="$model" LOCAL="$local_tag" URL="$url" CUSTOM="$custom" NAME="Your own · $host" \
      KEY="{file:$keyfile}" RULES="$rules" yq eval -o=json '
      .instructions = ((.instructions // []) + [strenv(RULES)] | unique) |
      with(select(strenv(LOCAL) != "");
        .provider.ollama.models[strenv(LOCAL)].name = strenv(LOCAL)) |
      with(select(strenv(URL) != "");
        .provider.custom = {"npm": "@ai-sdk/openai-compatible", "name": strenv(NAME),
          "options": {"baseURL": strenv(URL), "apiKey": strenv(KEY)}} |
        .provider.custom.models[strenv(CUSTOM)].name = strenv(CUSTOM)) |
      .model = strenv(MODEL)
    ' "$file" > "$tmp" 2> /dev/null; then
    warn "opencode: cannot parse $file (comments?); set model and instructions by hand"
    rm -f "$tmp"
    failed=1
    return
  fi
  if ! cmp -s "$tmp" "$file"; then
    say "opencode: the $ai agent in $file"
    cp "$tmp" "$file"
    changed
    # A running kortex keeps the server that read the file as it was, with the model
    # it named then: a cloud one for up to a quarter of an hour after "local" was
    # picked. It stops, and D-Bus starts it again at the next request.
    pkill -TERM -u "$(id -u)" -f kortex/kortex.py || true
  fi
  rm -f "$tmp"
  # The tools of every service the agent has (`mcp`) ask before they change something;
  # one connected before patina wrote these rules, or by hand, gets them here.
  for name in $(yq eval -r '.mcp // {} | keys | .[]' "$file" 2> /dev/null); do
    tmp="$(mktemp)"
    if service_permissions "$file" "$name" > "$tmp" 2> /dev/null && ! cmp -s "$tmp" "$file"; then
      say "opencode: the tools of $name ask before they change something"
      cp "$tmp" "$file"
      changed
      pkill -TERM -u "$(id -u)" -f kortex/kortex.py || true
    fi
    rm -f "$tmp"
  done
  [[ "$ai" == cloud ]] || return 0
  if [[ -n "$url" ]]; then
    say "ai: opencode uses your own API at $url ($custom)"
  elif ai_logged_in opencode "$provider"; then
    say "ai: opencode uses $provider"
  else
    say "ai: opencode is not logged in to $provider yet; the welcome does that at the next login, or patina ai login"
  fi
}

# Hermes Agent: its model in ~/.hermes/config.yaml (Ollama's OpenAI-compatible address, or
# the provider's `hermes` entry of ai.cloud.providers), manual approvals (Hermes asks
# first only before what it counts as dangerous; its default lets a second model let
# some of that through), its standing instructions (defaults/agent.md as
# agent.environment_hint, so the user's own SOUL.md stays theirs). The provider's key is
# in Hermes' own .env, where patina ai login puts it: nothing is asked here. Your own
# API's entry gets the address and model patina ai login recorded.
install_hermes() {
  local home="${HERMES_HOME:-$HOME/.hermes}" provider="" entry key="" url="" tmp
  local gate="$PATINA_PATH/bin/patina ai gate" allowed="${HERMES_HOME:-$HOME/.hermes}/shell-hooks-allowlist.json"
  local file="$home/config.yaml" settings="$PATINA_PATH/defaults/settings.yaml"
  if [[ "$ai" == local ]]; then
    [[ -n "$(local_model)" ]] || die "no model of ai.local.models fits this machine"
    entry="$(MODEL="$(local_model)" yq eval -n -o=json -I=0 \
      '{"provider": "custom", "default": strenv(MODEL), "base_url": "http://127.0.0.1:11434/v1", "api_key": "ollama"}')"
  else
    provider="$(cloud_provider hermes)"
    entry="$(P="$provider" yq eval -e -o=json -I=0 '.ai.cloud.providers[] | select(.id == strenv(P)) | .hermes.model' \
      "$settings" 2> /dev/null)" || die "Hermes has no entry for the cloud provider '$provider' in defaults/settings.yaml"
    key="$(P="$provider" yq eval '.ai.cloud.providers[] | select(.id == strenv(P)) | .hermes.key' "$settings")"
    if [[ "$(provider_login "$provider")" == endpoint ]]; then
      url="$(endpoint_value url)"
      [[ -n "$url" && -n "$(endpoint_value model)" ]] || die "your own API has no address yet: patina ai login asks for it"
      # shellcheck disable=SC2016 # ${URL} and ${MODEL} are the entry's placeholders, not the shell's
      entry="$(URL="$url" MODEL="$(endpoint_value model)" yq eval -o=json -I=0 '(.. | select(tag == "!!str")) |=
        (split("${URL}") | join(strenv(URL)) | split("${MODEL}") | join(strenv(MODEL)))' <<< "$entry")"
    fi
  fi
  mkdir -p "$home"
  [[ -s "$file" ]] || echo '{}' > "$file"
  tmp="$(mktemp)"
  # The model entry as a whole, so nothing of another provider (its address) stays behind.
  # The gate: Hermes' hook before every tool of a service (`patina ai gate`), which
  # sends the ones that change something to its approval. It fails closed: a gate
  # that cannot run stops the tool, it does not let it through.
  if ! ENTRY="$entry" RULES="$(< "$PATINA_PATH/defaults/agent.md")" GATE="$gate" yq eval \
      '.model = (strenv(ENTRY) | from_json) | .approvals.mode = "manual" | .agent.environment_hint = strenv(RULES) |
       .hooks.pre_tool_call = ([.hooks.pre_tool_call // [] | .[] | select(.command != strenv(GATE))] +
         [{"matcher": "mcp__.*|tool_call", "command": strenv(GATE), "timeout": 20, "fail_closed": true}])' \
      "$file" > "$tmp" 2> /dev/null; then
    warn "hermes: cannot parse $file; set model, approvals.mode and agent.environment_hint by hand"
    rm -f "$tmp"
    failed=1
    return
  fi
  # Compared as data: yq moves the comments around a replaced entry on each pass.
  if [[ "$(yq eval -o=json -I=0 '.' "$tmp")" != "$(yq eval -o=json -I=0 '.' "$file")" ]]; then
    say "hermes: the $ai agent in $file"
    cp "$tmp" "$file"
    changed
  fi
  rm -f "$tmp"
  # Hermes runs a hook only once it is allowed, which it asks on a terminal; its gateway
  # has none, so the gate is named in the list it keeps of the hooks allowed.
  [[ -s "$allowed" ]] || echo '{}' > "$allowed"
  if ! GATE="$gate" yq eval -e '.approvals // [] | any_c(.event == "pre_tool_call" and .command == strenv(GATE))' \
      "$allowed" > /dev/null 2>&1; then
    tmp="$(mktemp)"
    if GATE="$gate" yq eval -o=json -I=2 '.approvals = (.approvals // []) + [{"event": "pre_tool_call", "command": strenv(GATE)}]' \
        "$allowed" > "$tmp" 2> /dev/null; then
      say "hermes: the tools of a service ask before they change something"
      cp "$tmp" "$allowed"
      changed
    else
      warn "hermes: cannot parse $allowed; a service's tools will not ask"
      failed=1
    fi
    rm -f "$tmp"
  fi
  [[ "$ai" == cloud ]] || return 0
  if [[ -n "$url" ]]; then
    say "ai: Hermes uses your own API at $url ($(endpoint_value model))"
  elif ai_logged_in hermes "$provider"; then
    say "ai: Hermes has a key for $provider"
  else
    say "ai: Hermes has no key for $provider yet; the welcome asks for it at the next login, or patina ai login"
  fi
}

# The AI agent the question chose: kortex's choice of agent, the agent's own setup, the
# local model pulled into Ollama, and the warning about the model: a small local model
# errs more often, a US provider takes what is asked out of the EU.
install_ai() {
  local kortex_agent="${XDG_CONFIG_HOME:-$HOME/.config}/kortex/agent" model
  [[ -n "$ai" && "$ai" != none ]] || return 0
  # kortex, the agent in the command palette, talks to the agent this file names.
  if [[ "$(cat "$kortex_agent" 2> /dev/null || true)" != "$agent" ]]; then
    mkdir -p "$(dirname "$kortex_agent")"
    echo "$agent" > "$kortex_agent"
    say "kortex: talks to $agent"
    changed
  fi
  if [[ "$agent" == hermes ]]; then
    install_hermes
  else
    install_opencode
  fi
  if [[ "$ai" == cloud ]]; then
    ai_note cloud "$(cloud_provider "$agent")"
    return 0
  fi
  model="$(local_model)"
  # `ollama list` names an untagged model with :latest.
  if ! ollama list > /dev/null 2>&1; then
    say "ai: Ollama is not running (a container?); later: ollama pull $model"
  elif ollama list | awk 'NR > 1 { print $1 }' | grep -qx "$model$([[ "$model" == *:* ]] || echo :latest)"; then
    say "ai: $model is in Ollama"
  else
    say "ai: pulling $model into Ollama (a few GB, once)"
    if ollama pull "$model"; then
      changed
    else
      # A newer model can need a newer Ollama than the one installed.
      warn "ai: pulling $model failed; update Ollama (its installer, manifest/upstream.yaml) and run: ollama pull $model"
      failed=1
    fi
  fi
  ai_note local "$model"
}

# The theme, through `patina theme set`: PATINA_THEME, else the one already recorded,
# else the default of defaults/settings.yaml. The first install also gives the desktop
# the theme's panel layout (Plasma's stock bar is all that exists then); later runs
# leave the panels alone. Counts as a change when a renderer changed something.
install_theme() {
  local theme out
  local -a flags=()
  theme="${PATINA_THEME:-}"
  [[ -n "$theme" ]] || theme="$(current_theme || yq eval '.theme' "$PATINA_PATH/defaults/settings.yaml")"
  [[ $first_install -eq 0 ]] || flags+=(--layout)
  out="$(mktemp)"
  if ! "$PATINA_PATH/bin/patina-theme" set "$theme" "${flags[@]}" | tee "$out"; then
    warn "theme: '$theme' failed to apply"
    failed=1
  fi
  if grep -q ' change(s)' "$out"; then
    changed
  fi
  rm -f "$out"
}

record_state() {
  local m
  mkdir -p "$PATINA_STATE/migrations"
  # Nothing is ever removed, so the record is every bundle installed so far; doctor
  # checks them all.
  { [[ -f "$PATINA_STATE/bundles" ]] && cat "$PATINA_STATE/bundles"; printf '%s\n' "${bundles[@]}"; } |
    awk 'NF && !seen[$0]++' > "$PATINA_STATE/bundles.new"
  mv "$PATINA_STATE/bundles.new" "$PATINA_STATE/bundles"
  # The AI answer, offered first next time; none too, so the question remembers it.
  if [[ -n "$ai" ]]; then
    echo "$ai" > "$PATINA_STATE/ai"
    [[ "$ai" == none ]] || echo "$agent" > "$PATINA_STATE/ai-agent"
    [[ "$ai" != cloud ]] || cloud_provider "$agent" > "$PATINA_STATE/ai-provider"
    [[ "$ai" != local ]] || local_model > "$PATINA_STATE/ai-model"
  fi
  if [[ $first_install -eq 1 ]]; then
    # A fresh install is the end state every migration leads to, so none is pending.
    for m in "$PATINA_PATH"/migrations/[0-9]*.sh; do
      [[ -e "$m" ]] || continue
      date -u +%FT%TZ > "$PATINA_STATE/migrations/$(basename "$m")"
    done
    date -u +%FT%TZ > "$PATINA_STATE/installed-at"
  fi
}

main() {
  local chosen="" all=0 list=0 b
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bundles)
        [[ $# -ge 2 ]] || die "--bundles needs a list"
        chosen="$2"
        shift 2
        ;;
      --bundles=*)
        chosen="${1#*=}"
        shift
        ;;
      --all)
        all=1
        shift
        ;;
      --list)
        list=1
        shift
        ;;
      --unattended)
        PATINA_UNATTENDED=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        die "unknown option '$1'"
        ;;
    esac
  done
  export PATINA_UNATTENDED="${PATINA_UNATTENDED:-}"

  [[ -e "$PATINA_STATE/installed-at" ]] || first_install=1
  bootstrap_yq
  if [[ $list -eq 1 ]]; then
    list_bundles
    exit 0
  fi
  BACKEND="$(backend_file)"
  UPSTREAM="$PATINA_PATH/manifest/upstream.yaml"

  # The AI answer: local, cloud, none, or empty when --bundles leaves the agent alone; and
  # the agent, opencode or hermes.
  ai="$(current_ai)"
  agent="$(current_agent)"
  bundles=()
  if [[ $all -eq 1 ]]; then
    mapfile -t bundles < <(all_bundles)
    [[ "$ai" != none ]] || ai=local
  elif [[ -n "$chosen" ]]; then
    mapfile -t bundles < <(printf 'base\n%s\n' "${chosen//,/$'\n'}" | awk 'NF && !seen[$0]++')
    [[ -n "${PATINA_AI:-}" ]] || ai=""
    for b in "${bundles[@]}"; do
      [[ -f "$PATINA_PATH/manifest/bundles/$b.yaml" ]] || die "no bundle '$b' (try --list)"
      [[ -n "${PATINA_AI:-}" ]] || ai="$(yq eval ".ai // \"$ai\"" "$PATINA_PATH/manifest/bundles/$b.yaml")"
      if [[ -z "${PATINA_AI_AGENT:-}" ]] && yq eval -e '.ai' "$PATINA_PATH/manifest/bundles/$b.yaml" > /dev/null 2>&1; then
        agent="$(yq eval '.agent // "opencode"' "$PATINA_PATH/manifest/bundles/$b.yaml")"
      fi
    done
  else
    # What this machine has (recorded_bundles: the defaults before the first install),
    # so a re-run or `patina update` never adds the bundles a user left out; one that no
    # longer exists is skipped.
    for b in $(recorded_bundles); do
      [[ -f "$PATINA_PATH/manifest/bundles/$b.yaml" ]] && bundles+=("$b")
    done
    if [[ -t 0 && -t 1 && -z "$PATINA_UNATTENDED" ]]; then
      # The questions need gum (base bundle), which a stock Debian lacks before the
      # first install: fetch it first, or go on with the defaults without it.
      if ! command -v gum > /dev/null; then
        say "installing gum for the questions"
        { backend_run refresh && backend_run install gum && changed; } ||
          warn "gum could not be installed; going on with the defaults"
      fi
      if command -v gum > /dev/null; then
        ask
      fi
    fi
  fi
  if [[ -n "$ai" && "$ai" != none ]]; then
    b="$(ai_bundle "$ai" "$agent")" || die "no bundle in manifest/bundles/ answers ai: $ai with $agent"
    mapfile -t bundles < <(printf '%s\n' "${bundles[@]}" "$b" | awk 'NF && !seen[$0]++')
  fi
  say "bundles: ${bundles[*]} ($(basename "$BACKEND" .yaml) backend, $(uname -m))"

  mapfile -t packages < <(bundle_items packages "${bundles[@]}")
  # The device glue of devices/ for this machine: its packages and its system files.
  mapfile -t devices < <(detected_devices)
  for b in "${devices[@]}"; do
    say "device: $(yq eval '.name' "$PATINA_PATH/devices/$b/device.yaml") (devices/$b/)"
    mapfile -t -O "${#packages[@]}" packages < \
      <(yq eval '.extra_packages[]?' "$PATINA_PATH/devices/$b/device.yaml")
  done
  mapfile -t flatpaks < <(bundle_items flatpaks "${bundles[@]}")
  mapfile -t upstream < <(bundle_items upstream "${bundles[@]}")

  section packages
  install_packages
  section flatpaks
  install_flatpaks
  section upstream
  for b in "${upstream[@]}"; do
    install_upstream "$b"
  done
  section system
  install_system
  install_apps
  section "ai agent"
  install_ai
  record_state
  section theme
  install_theme

  if [[ $failed -ne 0 ]]; then
    die "finished with errors (see above)"
  fi
  if [[ $changes -eq 0 ]]; then
    say "nothing to do"
  else
    say "done: $changes changes"
  fi
}

main "$@"
