// Generated by patina from themes/${THEME}; do not edit. The one piece of code a theme
// renders: the wordmark on the theme's background and one accent line that grows as
// Plasma starts (stage 1 to 5). No text, no spinner. KSplashQML sets `stage`.
import QtQuick

Rectangle {
    id: root
    color: "${BASE00}"
    property int stage

    onStageChanged: {
        if (stage === 2) {
            fadeIn.running = true
        }
    }

    Item {
        id: content
        anchors.fill: parent
        opacity: 0

        Image {
            id: logo
            source: Qt.resolvedUrl("images/logo.svg")
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.verticalCenter: parent.verticalCenter
            anchors.verticalCenterOffset: -Math.round(parent.height * 0.06)
            width: Math.round(parent.width * 0.22)
            fillMode: Image.PreserveAspectFit
            sourceSize.width: width
            smooth: true
        }

        Rectangle {
            id: track
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: logo.bottom
            anchors.topMargin: Math.round(parent.height * 0.05)
            width: logo.width
            height: 2
            color: "${BASE02}"
        }

        Rectangle {
            id: glow
            anchors.left: line.left
            anchors.verticalCenter: line.verticalCenter
            width: line.width
            height: 8
            radius: 4
            color: "${BASE0F}"
            opacity: 0.35
        }

        Rectangle {
            id: line
            anchors.left: track.left
            anchors.verticalCenter: track.verticalCenter
            width: track.width * Math.min(Math.max(root.stage, 1), 5) / 5
            height: 2
            color: "${BASE0E}"
            Behavior on width {
                NumberAnimation { duration: 250; easing.type: Easing.InOutQuad }
            }
        }
    }

    OpacityAnimator {
        id: fadeIn
        target: content
        from: 0
        to: 1
        duration: 400
        easing.type: Easing.InOutQuad
        running: false
    }
}
