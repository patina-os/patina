[Desktop Entry]
Type=Application
Name=Ask ${AGENT_TITLE}
Comment=The command palette on ${AGENT_TITLE} alone: type your request and read the answer there
Exec=dbus-send --session --type=method_call --dest=org.kde.krunner /App org.kde.krunner.App.querySingleRunner string:kortex string:
Icon=${ASK_ICON}
Terminal=false
Categories=Utility;
Keywords=ai;agent;ask;kortex;krunner;
