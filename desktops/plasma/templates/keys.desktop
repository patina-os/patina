[Desktop Entry]
Type=Application
Name=patina keys
Comment=The keyboard shortcuts of this desktop at a glance
Exec=kitty --class patina-keys --title "patina keys" "${PATINA_PATH}/bin/patina" keys --wait
Icon=preferences-desktop-keyboard-shortcuts
Terminal=false
Categories=Utility;
Keywords=keys;shortcuts;hotkeys;cheat sheet;
StartupWMClass=patina-keys
