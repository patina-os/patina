[Desktop Entry]
Type=Application
Name=Agent (${AGENT})
Comment=The agent CLI in its own patina terminal profile
Exec=kitty --config "${CONFIG_HOME}/kitty/patina-agent.conf" --class patina-agent --title agent ${AGENT_COMMAND}
Icon=utilities-terminal
Terminal=false
Categories=Development;
Keywords=agent;ai;terminal;
StartupWMClass=patina-agent
