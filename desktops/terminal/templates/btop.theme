# patina: the ${DISPLAY_NAME} theme for btop, from its base16 palette. `patina theme set`
# overwrites this file; copy it under another name to change it.
theme[main_bg]="${BASE00}"
theme[main_fg]="${BASE05}"
theme[title]="${BASE06}"
theme[hi_fg]="${ACCENT}"
theme[selected_bg]="${BASE02}"
theme[selected_fg]="${BASE07}"
theme[inactive_fg]="${BASE03}"
theme[graph_text]="${BASE04}"
theme[meter_bg]="${BASE02}"
theme[proc_misc]="${BASE0C}"
theme[div_line]="${BASE02}"

# The boxes take the accents.
theme[cpu_box]="${ACCENT}"
theme[mem_box]="${BASE0B}"
theme[net_box]="${BASE0D}"
theme[proc_box]="${ACCENT_ALT}"

# Gradients: the load ones run from base0D through the accent to its second colour.
theme[cpu_start]="${BASE0D}"
theme[cpu_mid]="${ACCENT}"
theme[cpu_end]="${ACCENT_ALT}"
theme[temp_start]="${BASE0B}"
theme[temp_mid]="${BASE0A}"
theme[temp_end]="${BASE08}"
theme[free_start]="${BASE0C}"
theme[free_mid]=""
theme[free_end]="${BASE0B}"
theme[cached_start]="${BASE0D}"
theme[cached_mid]=""
theme[cached_end]="${BASE0C}"
theme[available_start]="${BASE0A}"
theme[available_mid]=""
theme[available_end]="${BASE09}"
theme[used_start]="${ACCENT}"
theme[used_mid]=""
theme[used_end]="${ACCENT_ALT}"
theme[download_start]="${BASE0D}"
theme[download_mid]="${ACCENT}"
theme[download_end]="${ACCENT_ALT}"
theme[upload_start]="${BASE0C}"
theme[upload_mid]="${BASE0D}"
theme[upload_end]="${ACCENT}"
theme[process_start]="${BASE0B}"
theme[process_mid]="${BASE0A}"
theme[process_end]="${BASE08}"
