// patina21: written by `patina theme set` while this first line stays; remove it to keep
// your own configuration. The logo is a gradient copy of branding/logo.txt.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "${DATA_HOME}/patina21/logo.txt",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "${ACCENT_SGR}", "title": "${ACCENT_SGR}" },
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "de",
    "shell",
    "terminal",
    { "type": "custom", "key": "Theme", "format": "patina21 ${DISPLAY_NAME}" },
    "memory",
    "break",
    "colors"
  ]
}
