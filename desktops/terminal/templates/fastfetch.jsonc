// patina: written by `patina theme set` while this first line stays; remove it to keep
// your own configuration. The logo is a coloured copy of branding/logo.txt.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "${STATE_HOME}/logo.txt",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "${ACCENT_SGR}", "title": "${ACCENT_SGR}" },
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "de",
    "shell",
    // Not fastfetch's terminal module: on Debian it asks kitty for its version over the
    // terminal (fastfetch 2.40 misses kitty's own file there), and on a slow machine the
    // answer came after fastfetch had stopped waiting, onto the shell's prompt. The
    // greeting runs in kitty only, so the line names it.
    { "type": "custom", "key": "Terminal", "format": "kitty" },
    { "type": "custom", "key": "Theme", "format": "patina ${DISPLAY_NAME}" },
    "memory",
    "break",
    "colors"
  ]
}
